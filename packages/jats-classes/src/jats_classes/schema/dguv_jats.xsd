<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:mml="http://www.w3.org/1998/Math/MathML"
  xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified">

  <!-- /standard-modules/* taken from JATS Publishing xs Package -->
  <xsd:import namespace="http://www.w3.org/1999/xlink" schemaLocation="standard-modules/xlink.xsd"/>
  <xsd:import namespace="http://www.w3.org/XML/1998/namespace"
    schemaLocation="standard-modules/xml.xsd"/>
  <xsd:import namespace="http://www.niso.org/schemas/ali/1.0/"/>
  <xsd:import namespace="http://www.w3.org/1998/Math/MathML"
    schemaLocation="standard-modules/mathml3/mathml3.xsd"/> 

  <xsd:element name="article">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>article</h3>
          <p>Definiert den Hauptinhalt eines wissenschaftlichen Artikels oder Dokuments. Die
            Struktur kann &lt;front&gt;, &lt;body&gt; und &lt;back&gt; Elemente enthalten, um die
            verschiedenen Teile des Artikels zu repraesentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>article</h3>
          <p>Defines the main content of a scientific article or document. The structure may include
            &lt;front&gt;, &lt;body&gt;, and &lt;back&gt; elements to represent the different parts
            of the article.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="front"/>
        <xsd:element ref="body"/>
        <xsd:element ref="back" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="article-type" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:token">
            <xsd:enumeration value="DGUV Vorschriften- und Regelwerk"/>
            <xsd:enumeration value="editorial"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="dtd-version" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="1.1"/>
            <xsd:enumeration value="1.1d1"/>
            <xsd:enumeration value="1.1d2"/>
            <xsd:enumeration value="1.1d3"/>
            <xsd:enumeration value="1.2"/>
            <xsd:enumeration value="1.2d1"/>
            <xsd:enumeration value="1.2d2"/>
            <xsd:enumeration value="1.3"/>
            <xsd:enumeration value="1.3d1"/>
            <xsd:enumeration value="1.3d2"/>
            <xsd:enumeration value="3.0"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="required"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="front">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>front</h3>
          <p>Definiert den vorderen Teil eines wissenschaftlichen Artikels oder Dokuments, der
            Elemente wie den Artikel-Titel, Autoren, Zugehoerigkeiten und Zusammenfassungen
            enthalten kann. Diese Struktur dient als Einfuehrung und Ueberblick ueber den
            Artikel.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>front</h3>
          <p>Defines the front matter of a scientific article or document, which may include
            elements such as the article title, authors, affiliations, and abstracts. This structure
            serves as an introduction and overview of the article.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="journal-meta"/>
        <xsd:element ref="article-meta"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- == JOURNAL META == -->
  <xsd:element name="journal-meta">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>journal-meta</h3>
          <p>Definiert die Metadaten einer Zeitschrift innerhalb der JATS-Struktur. Dies kann
            Informationen wie den Zeitschriftentitel, ISSN(s), den Verlag und andere relevante Daten
            enthalten. Diese Elemente sind entscheidend fuer die Identifizierung und Kategorisierung
            der Zeitschrift in wissenschaftlichen Datenbanken.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>journal-meta</h3>
          <p>Defines the metadata of a journal within the JATS structure. This may include
            information such as the journal title, ISSN(s), the publisher, and other relevant data.
            These elements are crucial for identifying and categorizing the journal in scientific
            databases.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="journal-id" maxOccurs="unbounded"/>
        <xsd:element ref="journal-title-group" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="issn" maxOccurs="unbounded"/>
        <xsd:element ref="publisher" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <xsd:element name="journal-id">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>journal-id</h3>
          <p>Ein kurzer Code oder eine Abkuerzung, die als Identifikator fuer eine Zeitschrift
            dient. Der &lt;journal-id&gt;-Element haelt einen externen Identifikator, der
            typischerweise von einem Verlag, Archiv oder einer Bibliothek zugewiesen wird, um eine
            eindeutige Identifizierung der Zeitschrift zu gewaehrleisten. Dieser Identifikator kann
            in der JATS-Struktur innerhalb von &lt;journal-meta&gt; vorkommen und dient dazu, die
            Zeitschrift eindeutig zu identifizieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>journal-id</h3>
          <p>A short code or abbreviation used as an identifier for a journal. The
            &lt;journal-id&gt; element holds an external identifier, typically assigned by a
            publisher, archive, or library to provide a unique identifier for the journal. This
            identifier may appear within &lt;journal-meta&gt; in the JATS structure and serves to
            uniquely identify the journal.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="journal-title-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>journal-title-group</h3>
          <p>Ein Container-Element fuer die Titel der Zeitschrift, in der der Artikel
            veroeffentlicht wurde. Dieses Element kann wiederholt werden, wenn die Zeitschrift
            mehrere voellig unterschiedliche Titel hat. Uebersetzte Titel (&lt;trans-title&gt;) und
            uebersetzte Untertitel (&lt;trans-subtitle&gt;) haben ihre eigene wiederholbare
            Markup-Gruppe (&lt;trans-title-group&gt;) innerhalb des
            &lt;journal-title-group&gt;-Elements. Es ist ein zentrales Element innerhalb von
            &lt;journal-meta&gt;, das dazu dient, die Identitaet und den thematischen Fokus der
            Zeitschrift zu definieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>journal-title-group</h3>
          <p>A container element for the titles of the journal in which the article was published.
            This element may be repeated when the journal has multiple fully distinct titles.
            Translated titles (&lt;trans-title&gt;) and translated subtitles
            (&lt;trans-subtitle&gt;) have their own repeatable markup group
            (&lt;trans-title-group&gt;) within the &lt;journal-title-group&gt; element. It is a key
            element within &lt;journal-meta&gt; that serves to define the identity and thematic
            focus of the journal.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="journal-title" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="journal-subtitle" minOccurs="0" maxOccurs="unbounded"/>
        <!--<xsd:element ref="trans-title-group" minOccurs="0" maxOccurs="unbounded"/>-->
        <!--<xsd:element ref="abbrev-journal-title" minOccurs="0" maxOccurs="unbounded"/>-->
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="journal-title">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>journal-title</h3>
          <p>Das Element &lt;journal-title&gt; dient zur Angabe des vollstaendigen Titels einer
            Zeitschrift, in der ein Artikel veroeffentlicht wurde. Es ist ein wesentlicher
            Bestandteil innerhalb des &lt;journal-title-group&gt;-Elements und spielt eine zentrale
            Rolle bei der Identifizierung der Zeitschrift in bibliografischen Datenbanken und
            Zitierungen. Der Titel wird in der Regel in der Originalsprache der Publikation
            angegeben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>journal-title</h3>
          <p>The &lt;journal-title&gt; element is used to specify the full title of a journal in
            which an article was published. It is a key component within the
            &lt;journal-title-group&gt; element and plays a central role in identifying the journal
            in bibliographic databases and citations. The title is typically provided in the
            original language of the publication.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="journal-subtitle">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>journal-subtitle</h3>
          <p>Das Element &lt;journal-subtitle&gt; wird verwendet, um den Untertitel einer
            Zeitschrift anzugeben, der zusaetzliche Informationen zum Haupttitel liefert oder diesen
            ergaenzt. Es tritt typischerweise in Verbindung mit dem &lt;journal-title&gt;-Element
            innerhalb der &lt;journal-title-group&gt; auf. Der Untertitel kann dazu dienen, den
            thematischen Schwerpunkt der Zeitschrift genauer zu beschreiben oder zusaetzliche
            charakterisierende Informationen bereitzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>journal-subtitle</h3>
          <p>The &lt;journal-subtitle&gt; element is used to provide the subtitle of a journal,
            offering additional information to or complementing the main title. It typically appears
            in conjunction with the &lt;journal-title&gt; element within the
            &lt;journal-title-group&gt;. The subtitle may serve to more precisely describe the
            thematic focus of the journal or to provide additional characterizing information.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="publisher">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>publisher</h3>
          <p>Das Element &lt;publisher&gt; wird verwendet, um Informationen ueber den Verlag zu
            erfassen, der ein Werk veroeffentlicht hat. Es kann innerhalb der Zeitschriften- und
            Buchmetadaten in der JATS-Struktur auftreten. Dieses Element kann Angaben wie den Namen
            des Verlags und dessen Standort enthalten. Die Erfassung dieser Informationen ist
            entscheidend fuer die Nachverfolgbarkeit von Publikationen und die Zuordnung von
            Urheberrechten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>publisher</h3>
          <p>The &lt;publisher&gt; element is used to capture information about the publishing
            entity that has published a work. It can appear within the journal and book metadata in
            the JATS structure. This element may include details such as the name of the publisher
            and its location. Capturing this information is crucial for the traceability of
            publications and the assignment of copyrights.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence maxOccurs="unbounded">
        <xsd:element ref="publisher-name"/>
        <xsd:element ref="publisher-loc" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="publisher-name">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>publisher-name</h3>
          <p>Das Element &lt;publisher-name&gt; dient zur Angabe des Namens des Verlags, der ein
            Werk veroeffentlicht hat. Es findet typischerweise Verwendung innerhalb der
            Verlagsangaben in den Metadatenbereichen von Zeitschriften (&lt;journal-meta&gt;) und
            Buechern (&lt;book-meta&gt;) in der JATS-Struktur. Die praezise Angabe des Verlagsnamens
            ist fuer die Identifikation und das Auffinden von Publikationen von Bedeutung.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>publisher-name</h3>
          <p>The &lt;publisher-name&gt; element is used to specify the name of the publisher that
            has published a work. It is typically found within the publisher information in the
            metadata sections of journals (&lt;journal-meta&gt;) and books (&lt;book-meta&gt;) in
            the JATS structure. Accurately specifying the publisher's name is important for the
            identification and retrieval of publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="publisher-loc">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>publisher-loc</h3>
          <p>Das Element &lt;publisher-loc&gt; dient zur Angabe des Standorts des Verlags, der ein
            Werk veroeffentlicht hat. Es findet typischerweise Verwendung innerhalb der
            Verlagsangaben in den Metadatenbereichen von Zeitschriften (&lt;journal-meta&gt;) und
            Buechern (&lt;book-meta&gt;) in der JATS-Struktur. Die Angabe des Standorts ist wichtig
            fuer die Identifikation des Verlags und kann bei der rechtlichen Klaerung von
            Publikationsrechten hilfreich sein.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>publisher-loc</h3>
          <p>The &lt;publisher-loc&gt; element is used to specify the location of the publisher that
            has published a work. It is typically found within the publisher information in the
            metadata sections of journals (&lt;journal-meta&gt;) and books (&lt;book-meta&gt;) in
            the JATS structure. Specifying the location is important for identifying the publisher
            and can be helpful in the legal clarification of publication rights.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="addr-line"/>
        <xsd:element ref="city"/>
        <xsd:element ref="email"/>
        <xsd:element ref="fax"/>
        <xsd:element ref="institution"/>
        <xsd:element ref="phone"/>
        <xsd:element ref="postal-code"/>
        <xsd:element ref="uri"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="issn">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>issn</h3>
          <p>Die &lt;issn&gt; wird im Kontext von &lt;book-meta&gt;, &lt;collection-meta&gt; und
            &lt;journal-meta&gt; verwendet, um die Internationale Standardseriennummer eines Buches
            oder einer Zeitschrift zu spezifizieren. Sie dient der eindeutigen Identifizierung von
            periodisch erscheinenden Publikationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>issn</h3>
          <p>The &lt;issn&gt; is used within the context of &lt;book-meta&gt;,
            &lt;collection-meta&gt;, and &lt;journal-meta&gt; to specify the International Standard
            Serial Number of a book or journal. It serves to uniquely identify periodical
            publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- == END JOURNAL META == -->


  <!-- == ARTICLE META == -->
  <!-- METADATA NEEDS TO BE DEFINED MORE PRECISELY (2024-0216) -->
  <xsd:element name="article-meta">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>article-meta</h3>
          <p>Das Element &lt;article-meta&gt; wird verwendet, um Metadaten eines Artikels zu
            definieren, einschliesslich Titel, Autoren, Affiliationen und Publikationsdatum. Es
            tritt typischerweise innerhalb des &lt;front&gt;-Elements eines JATS-Dokuments auf.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>article-meta</h3>
          <p>The &lt;article-meta&gt; element is used to define metadata of an article, including
            title, authors, affiliations, and publication date. It typically occurs within the
            &lt;front&gt; element of a JATS document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="article-id" minOccurs="0" maxOccurs="1"/>
        <xsd:element ref="article-categories" minOccurs="0"/>
        <xsd:element ref="title-group"/>
        <xsd:element ref="contrib-group" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="pub-date" minOccurs="1" maxOccurs="unbounded"/>
        <xsd:element ref="volume" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="issue" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="history" minOccurs="0"/>
        <xsd:element ref="permissions" minOccurs="0"/>
        <xsd:element ref="uri" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="self-uri" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="abstract" minOccurs="1" maxOccurs="unbounded"/>
        <xsd:element ref="trans-abstract" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="kwd-group" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="custom-meta-group" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="article-id">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>article-id</h3>
          <p>Das Element &lt;article-id&gt; wird verwendet, um eine eindeutige Kennung eines
            Artikels innerhalb der JATS-Struktur zu definieren. Es kann verschiedene Arten von
            Identifikatoren aufnehmen, wie z.B. DOI (Digital Object Identifier), PMID (PubMed
            Identifier) oder andere spezifische Kennungen, die von Verlagen oder Datenbanken
            verwendet werden. Es findet sich typischerweise im &lt;article-meta&gt;-Bereich.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>article-id</h3>
          <p>The &lt;article-id&gt; element is used to define a unique identifier for an article
            within the JATS structure. It can accommodate various types of identifiers, such as DOI
            (Digital Object Identifier), PMID (PubMed Identifier), or other specific identifiers
            used by publishers or databases. It is typically found in the &lt;article-meta&gt;
            section.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="custom-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="pub-id-type" use="optional">
        <xsd:simpleType>

          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="accession"/>
            <xsd:enumeration value="archive"/>
            <xsd:enumeration value="ark"/>
            <xsd:enumeration value="art-access-id"/>
            <xsd:enumeration value="arxiv"/>
            <xsd:enumeration value="coden"/>
            <xsd:enumeration value="custom"/>
            <xsd:enumeration value="doaj"/>
            <xsd:enumeration value="doi"/>
            <xsd:enumeration value="handle"/>
            <xsd:enumeration value="index"/>
            <xsd:enumeration value="isbn"/>
            <xsd:enumeration value="manuscript"/>
            <xsd:enumeration value="medline"/>
            <xsd:enumeration value="mr"/>
            <xsd:enumeration value="other"/>
            <xsd:enumeration value="pii"/>
            <xsd:enumeration value="pmcid"/>
            <xsd:enumeration value="pmid"/>
            <xsd:enumeration value="publisher-id"/>
            <xsd:enumeration value="sici"/>
            <xsd:enumeration value="std-designation"/>
            <xsd:enumeration value="zbl"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="article-categories">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>article-categories</h3>
          <p>Das Element &lt;article-categories&gt; wird innerhalb der JATS-Struktur genutzt, um
            Artikel in verschiedene Kategorien einzuteilen. Diese Kategorisierung hilft bei der
            thematischen Organisation von Artikeln und erleichtert das Auffinden relevanter Inhalte.
            Es ist ueblicherweise im &lt;article-meta&gt;-Bereich zu finden und kann verschiedene
            Unterkategorien enthalten, die durch spezifische Elemente wie &lt;subj-group&gt;
            repraesentiert werden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>article-categories</h3>
          <p>The &lt;article-categories&gt; element is used within the JATS structure to classify
            articles into different categories. This categorization aids in the thematic
            organization of articles and facilitates the search for relevant content. It is
            typically found in the &lt;article-meta&gt; section and can contain various
            subcategories represented by specific elements such as &lt;subj-group&gt;.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="subj-group" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="subj-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>subj-group</h3>
          <p>Das Element &lt;subj-group&gt; wird in der JATS-Struktur verwendet, um Artikel nach
            Themen oder Disziplinen zu gruppieren. Es ermoeglicht eine feinere Kategorisierung
            innerhalb der &lt;article-categories&gt; und kann mehrfach vorkommen, um verschiedene
            thematische Gruppierungen zu repraesentieren. Dieses Element ist besonders nuetzlich
            fuer die Organisation von Inhalten in Fachzeitschriften, wo Artikel nach ihrem
            wissenschaftlichen Fachgebiet klassifiziert werden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>subj-group</h3>
          <p>The &lt;subj-group&gt; element is used within the JATS structure to group articles by
            topics or disciplines. It allows for more granular categorization within
            &lt;article-categories&gt; and can occur multiple times to represent different thematic
            groupings. This element is particularly useful for organizing content in scholarly
            journals, where articles are classified according to their scientific field.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice maxOccurs="unbounded">
        <xsd:element ref="subject"/>
        <xsd:element ref="subj-group"/>
      </xsd:choice>
      <xsd:attribute name="assigning-authority" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="subj-group-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="vocab" use="optional" type="xsd:string"/>
      <xsd:attribute name="vocab-identifier" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="subject">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>subject</h3>
          <p>Das Element &lt;subject&gt; wird in der JATS-Struktur verwendet, um den thematischen
            Inhalt eines Artikels zu beschreiben. Es kann innerhalb von &lt;subj-group&gt;
            auftreten, um spezifische Themen oder Schlagworte zu definieren, die den Inhalt des
            Artikels zusammenfassen. Dies ermoeglicht eine praezise thematische Klassifizierung und
            verbessert die Auffindbarkeit von Artikeln in wissenschaftlichen Datenbanken.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>subject</h3>
          <p>The &lt;subject&gt; element is used within the JATS structure to describe the thematic
            content of an article. It can occur within &lt;subj-group&gt; to define specific topics
            or keywords that summarize the article's content. This allows for precise thematic
            classification and enhances the findability of articles in scientific databases.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="assigning-authority" use="optional" type="xsd:string"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="vocab" use="optional" type="xsd:string"/>
      <xsd:attribute name="vocab-identifier" use="optional" type="xsd:string"/>
      <xsd:attribute name="vocab-term" use="optional" type="xsd:string"/>
      <xsd:attribute name="vocab-term-identifier" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <!-- ARTICLE TITLE GROUP - ARTICLE_TITLE, SUBTITLE -->
  <xsd:element name="title-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>title-group</h3>
          <p>Das Element &lt;title-group&gt; dient als Containerelement innerhalb der JATS-Struktur,
            um die Titel eines Artikels oder einer Zeitschrift zusammenzuhalten. Es kann den
            Haupttitel (&lt;journal-title&gt;, &lt;article-title&gt;), Untertitel (&lt;subtitle&gt;,
            &lt;journal-subtitle&gt;) und uebersetzte Titel und Untertitel
            (&lt;trans-title-group&gt;) umfassen. Dieses Element ermoeglicht eine strukturierte
            Darstellung der Titelinformationen und unterstuetzt die mehrsprachige Publikation von
            Inhalten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>title-group</h3>
          <p>The &lt;title-group&gt; element acts as a container element within the JATS structure
            to hold together the titles of an article or journal. It can include the main title
            (&lt;journal-title&gt;, &lt;article-title&gt;), subtitle (&lt;subtitle&gt;,
            &lt;journal-subtitle&gt;), and translated titles and subtitles
            (&lt;trans-title-group&gt;). This element allows for a structured presentation of title
            information and supports the multilingual publication of content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="article-title"/>
        <xsd:element ref="subtitle" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="article-title">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>article-title</h3>
          <p>Das Element &lt;article-title&gt; repraesentiert den Haupttitel eines Artikels
            innerhalb der JATS-Struktur. Es wird typischerweise in &lt;title-group&gt; innerhalb von
            &lt;article-meta&gt; verwendet, um den Titel des Artikels in der Originalsprache des
            Dokuments anzugeben. Dieses Element ist zentral fuer die Artikelidentifikation und hilft
            bei der Auffindbarkeit und Zitierfaehigkeit des Artikels in wissenschaftlichen
            Datenbanken und Bibliographien.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>article-title</h3>
          <p>The &lt;article-title&gt; element represents the main title of an article within the
            JATS structure. It is typically used within &lt;title-group&gt; inside
            &lt;article-meta&gt; to specify the title of the article in the document's original
            language. This element is crucial for article identification and assists in the
            article's findability and citability in scientific databases and bibliographies.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="subsup.class"/>
        <xsd:element ref="break"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="subtitle">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>subtitle</h3>
          <p>Das Element &lt;subtitle&gt; dient zur Angabe eines Untertitels, der zusaetzliche
            Informationen zum Haupttitel eines Artikels liefert oder diesen naeher erlaeutert. Es
            tritt haeufig in Kombination mit dem &lt;article-title&gt; innerhalb der
            &lt;title-group&gt; im &lt;article-meta&gt;-Bereich auf. Der Untertitel kann dazu
            beitragen, den Kontext oder den Fokus des Artikels genauer zu definieren und
            unterstuetzt somit eine praezisere inhaltliche Einordnung.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>subtitle</h3>
          <p>The &lt;subtitle&gt; element is used to provide a subtitle that offers additional
            information to the main title of an article or further elaborates on it. It often
            appears in conjunction with the &lt;article-title&gt; within the &lt;title-group&gt; in
            the &lt;article-meta&gt; section. The subtitle can help to more accurately define the
            context or focus of the article, thus supporting a more precise content
            categorization.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="subsup.class"/>
        <xsd:element ref="break"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END ARTICLE TITLE GROUP - ARTICLE_TITLE, SUBTITLE -->

  <!-- DATE  -->
  <xsd:element name="day" type="xsd:integer">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>day</h3>
          <p>Das Element &lt;day&gt; bezeichnet einen Tag des Monats in zweistelliger Form, wie er
            im internationalen Datumsformat JJJJ-MM-TT angegeben wird (zum Beispiel "03" fuer den
            dritten, "25" fuer den fuenfundzwanzigsten). Es wird sowohl in den Artikelmetadaten
            (&lt;article-meta&gt;) als auch innerhalb bibliografischer Referenzen
            (&lt;element-citation&gt; und &lt;mixed-citation&gt;) verwendet. Innerhalb von Zitaten
            (&lt;element-citation&gt; und &lt;mixed-citation&gt;) benennt dieses Element
            typischerweise den veroeffentlichungstag der zitierten Quelle. Die Elemente
            &lt;year&gt;, &lt;date&gt;, &lt;day&gt;, &lt;month&gt; und &lt;season&gt; koennen alle
            verwendet werden, um ein Datum in einem Zitat zu beschreiben, sowohl
            veroeffentlichungsdaten als auch andere Daten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>day</h3>
          <p>The &lt;day&gt; element names a day of the month in two-digit form as it would be
            stated in the international date format YYYY-MM-DD (for example, "03" for the third,
            "25" for the twenty-fifth). It is used in both the article metadata
            (&lt;article-meta&gt;) and within bibliographic references (&lt;element-citation&gt; and
            &lt;mixed-citation&gt;). Within citations (&lt;element-citation&gt; and
            &lt;mixed-citation&gt;), this element typically names the publication day of the cited
            source. The elements &lt;year&gt;, &lt;date&gt;, &lt;day&gt;, &lt;month&gt;, and
            &lt;season&gt; may all be used to describe a date in a citation, both publication dates
            and other dates.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

  </xsd:element>
  <xsd:element name="month">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>month</h3>
          <p>Das Element &lt;month&gt; bezeichnet einen Monat des Jahres in zweistelliger Form, wie
            er im internationalen Datumsformat JJJJ-MM-TT angegeben wird (zum Beispiel "04" fuer
            April, "11" fuer November). Es findet Verwendung in den Artikelmetadaten
            (&lt;article-meta&gt;) sowie innerhalb bibliografischer Referenzen
            (&lt;element-citation&gt; und &lt;mixed-citation&gt;). Innerhalb von Zitaten
            (&lt;element-citation&gt; und &lt;mixed-citation&gt;) benennt dieses Element
            typischerweise den veroeffentlichungsmonat der zitierten Quelle. Die Elemente
            &lt;year&gt;, &lt;date&gt;, &lt;day&gt;, &lt;month&gt; und &lt;season&gt; koennen alle
            verwendet werden, um ein Datum in einem Zitat zu beschreiben, sowohl
            veroeffentlichungsdaten als auch andere Daten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>month</h3>
          <p>The &lt;month&gt; element denotes a month of the year in two-digit form as it would be
            stated in the international date format YYYY-MM-DD (for example, "04" for April, "11"
            for November). It is used in both the article metadata (&lt;article-meta&gt;) and within
            bibliographic references (&lt;element-citation&gt; and &lt;mixed-citation&gt;). Within
            citations (&lt;element-citation&gt; and &lt;mixed-citation&gt;), this element typically
            names the publication month of the cited source. The elements &lt;year&gt;,
            &lt;date&gt;, &lt;day&gt;, &lt;month&gt;, and &lt;season&gt; may all be used to describe
            a date in a citation, both publication dates and other dates.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="year">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>year</h3>
          <p>Das Element &lt;year&gt; bezeichnet das Jahr in vierstelliger Form, wie es im
            internationalen Datumsformat JJJJ-MM-TT verwendet wird. Es ist ein wesentlicher
            Bestandteil der Datumsangaben in den Artikelmetadaten (&lt;article-meta&gt;) und wird
            auch in bibliografischen Referenzen (&lt;element-citation&gt; und
            &lt;mixed-citation&gt;) verwendet, um das veroeffentlichungsjahr einer zitierten Quelle
            anzugeben. Das &lt;year&gt;-Element kann zusammen mit den Elementen &lt;day&gt;,
            &lt;month&gt; und &lt;season&gt; verwendet werden, um ein vollstaendiges Datum oder
            einen Zeitraum innerhalb eines Zitats oder der Artikelmetadaten zu beschreiben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>year</h3>
          <p>The &lt;year&gt; element denotes the year in a four-digit format as used in the
            international date format YYYY-MM-DD. It is a crucial part of date information in
            article metadata (&lt;article-meta&gt;) and is also used in bibliographic references
            (&lt;element-citation&gt; and &lt;mixed-citation&gt;) to indicate the publication year
            of a cited source. The &lt;year&gt; element can be used alongside &lt;day&gt;,
            &lt;month&gt;, and &lt;season&gt; elements to describe a complete date or period within
            a citation or the article metadata.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="iso-8601-date" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="date">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>date</h3>
          <p>Das Element &lt;date&gt; wird verwendet, um ein Datum innerhalb der JATS-Struktur
            anzugeben. Es kann verschiedene Arten von Daten repraesentieren, wie
            veroeffentlichungsdaten, Zugriffsdaten, Copyright-Daten oder Zeitstempel. Das
            &lt;date&gt;-Element kann in verschiedenen Kontexten auftreten, einschliesslich
            &lt;article-meta&gt;, &lt;pub-date&gt;, &lt;date-in-citation&gt;, und &lt;history&gt;.
            Es ermoeglicht eine praezise Angabe von Datumsinformationen in einem standardisierten
            Format, was fuer die Archivierung, Suche und Wiederverwendung von wissenschaftlichen
            Artikeln von Bedeutung ist.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>date</h3>
          <p>The &lt;date&gt; element is used to specify a date within the JATS structure. It can
            represent various types of dates, such as publication dates, access dates, copyright
            dates, or timestamps. The &lt;date&gt; element can occur in various contexts, including
            &lt;article-meta&gt;, &lt;pub-date&gt;, &lt;date-in-citation&gt;, and &lt;history&gt;.
            It allows for the precise specification of date information in a standardized format,
            which is important for the archiving, searching, and reuse of scientific articles.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:sequence minOccurs="0">
          <xsd:element ref="day" minOccurs="0"/>
          <xsd:element ref="month"/>
        </xsd:sequence>
        <xsd:element ref="year"/>
      </xsd:sequence>
      <xsd:attribute name="date-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="iso-8601-date" use="optional" type="xsd:string"/>
      <xsd:attribute name="publication-format" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END DATE -->

  <!-- SPECIFIC DATE STRUCTURES -->
  <xsd:element name="pub-date">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>pub-date</h3>
          <p>Das Element &lt;pub-date&gt; dient zur Angabe des veroeffentlichungsdatums eines
            Dokuments innerhalb der JATS-Struktur. Es kann in verschiedenen Teilen des Dokuments
            verwendet werden, um das Datum der Erstveroeffentlichung, der elektronischen
            veroeffentlichung oder anderer relevanter veroeffentlichungsereignisse zu spezifizieren.
            Typischerweise findet sich dieses Element in &lt;article-meta&gt; und kann mehrfach
            vorkommen, um verschiedene Daten im Lebenszyklus eines Artikels zu dokumentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>pub-date</h3>
          <p>The &lt;pub-date&gt; element is used to specify the publication date of a document
            within the JATS structure. It can be used in various parts of the document to specify
            the date of first publication, electronic publication, or other relevant publication
            events. Typically, this element is found in &lt;article-meta&gt; and can occur multiple
            times to document different dates in the life cycle of an article.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:sequence minOccurs="0">
          <xsd:element ref="day" minOccurs="0"/>
          <xsd:element ref="month"/>
        </xsd:sequence>
        <xsd:element ref="year"/>
      </xsd:sequence>
      <xsd:attribute name="date-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="history">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>history</h3>
          <p>Das Element &lt;history&gt; wird in der JATS-Struktur verwendet, um die Historie oder
            den Verlauf eines Dokuments zu dokumentieren. Dies kann verschiedene Stadien der
            Manuskriptbearbeitung, ueberpruefung und veroeffentlichung umfassen. Typischerweise
            beinhaltet es Datumsangaben zu wichtigen Ereignissen im Lebenszyklus eines Artikels, wie
            zum Beispiel das Datum der Einreichung, der Annahme, der Online-veroeffentlichung und
            anderer relevanter Meilensteine. Das &lt;history&gt;-Element ermoeglicht eine
            detaillierte Chronologie der Dokumentenentwicklung und -veroeffentlichung.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>history</h3>
          <p>The &lt;history&gt; element is used within the JATS structure to document the history
            or progression of a document. This can include various stages of manuscript processing,
            review, and publication. Typically, it encompasses dates of significant events in the
            life cycle of an article, such as the date of submission, acceptance, online
            publication, and other relevant milestones. The &lt;history&gt; element allows for a
            detailed chronology of document development and publication.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" name="date">
          <xsd:annotation>
            <xsd:documentation xml:lang="de">
              <div>
                <h3>date</h3>
                <p>Das Element &lt;date&gt; wird verwendet, um ein Datum innerhalb der JATS-Struktur
                  anzugeben. Es kann verschiedene Arten von Daten repraesentieren, wie
                  veroeffentlichungsdaten, Zugriffsdaten, Copyright-Daten oder Zeitstempel. Das
                  &lt;date&gt;-Element kann in verschiedenen Kontexten auftreten, einschliesslich
                  &lt;article-meta&gt;, &lt;pub-date&gt;, &lt;date-in-citation&gt;, und &lt;history&gt;.
                  Es ermoeglicht eine praezise Angabe von Datumsinformationen in einem standardisierten
                  Format, was fuer die Archivierung, Suche und Wiederverwendung von wissenschaftlichen
                  Artikeln von Bedeutung ist.</p>
              </div>
            </xsd:documentation>
            <xsd:documentation xml:lang="en">
              <div>
                <h3>date</h3>
                <p>The &lt;date&gt; element is used to specify a date within the JATS structure. It can
                  represent various types of dates, such as publication dates, access dates, copyright
                  dates, or timestamps. The &lt;date&gt; element can occur in various contexts, including
                  &lt;article-meta&gt;, &lt;pub-date&gt;, &lt;date-in-citation&gt;, and &lt;history&gt;.
                  It allows for the precise specification of date information in a standardized format,
                  which is important for the archiving, searching, and reuse of scientific articles.</p>
              </div>
            </xsd:documentation>
          </xsd:annotation>
          
          <xsd:complexType>
            <xsd:sequence>
              <xsd:sequence minOccurs="0">
                <xsd:element ref="day" minOccurs="0"/>
                <xsd:element ref="month"/>
              </xsd:sequence>
              <xsd:element ref="year"/>
            </xsd:sequence>
            <xsd:attribute name="date-type" use="required">
              <xsd:simpleType>
                <xsd:restriction base="xsd:NMTOKEN">
                  <xsd:enumeration value="initial-publication"/>
                  <xsd:enumeration value="correction"/>
                  <xsd:enumeration value="latest-version"/>
                </xsd:restriction>
              </xsd:simpleType>
            </xsd:attribute>
            <xsd:attribute name="id" use="optional" type="xsd:ID"/>
            <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
            <xsd:attribute ref="xml:base" use="optional"/>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END SPECIFIC DATE STRUCTURES -->


  <!-- PERMISSIONS AND COPYRIGHT -->
  <xsd:element name="permissions">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>permissions</h3>
          <p>Das Element &lt;permissions&gt; wird in der JATS-Struktur genutzt, um Berechtigungen
            und Lizenzinformationen eines Dokuments zu gruppieren. Es kann Angaben zu
            Urheberrechten, Lizenztypen und Zugriffsrechten enthalten. Innerhalb dieses Elements
            koennen spezifische Unter-Elemente wie &lt;copyright-statement&gt;,
            &lt;copyright-year&gt; und &lt;copyright-holder&gt; vorkommen, die detaillierte
            Informationen zu den Urheberrechtsangaben des Dokuments bereitstellen. Das
            &lt;permissions&gt;-Element ermoeglicht es, die rechtlichen Rahmenbedingungen fuer die
            Nutzung und Verbreitung des Inhalts klar zu definieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>permissions</h3>
          <p>The &lt;permissions&gt; element is used within the JATS structure to group permissions
            and licensing information of a document. It can contain details on copyright, types of
            licenses, and access rights. Specific sub-elements such as &lt;copyright-statement&gt;,
            &lt;copyright-year&gt;, and &lt;copyright-holder&gt; may be included within this
            element, providing detailed information on the document's copyright claims. The
            &lt;permissions&gt; element allows for the clear definition of the legal framework
            governing the use and distribution of the content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="copyright-statement" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="copyright-year" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="copyright-holder" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="copyright-statement">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>copyright-statement</h3>
          <p>Das Element &lt;copyright-statement&gt; dient zur textuellen Darstellung des
            Urheberrechts, die fuer den Druck und die Anzeige vorgesehen ist. Es enthaelt in der
            Regel den Namen des Urheberrechtinhabers und das Jahr unter anderem. Dieses Element
            tritt innerhalb des Gruppierungselements &lt;permissions&gt; auf und ist fuer die
            Darstellung von Urheberrechtsinformationen in einem Dokument vorgesehen. Es kann dazu
            verwendet werden, spezifische Urheberrechtsansprueche eines Dokuments klar zu
            kommunizieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>copyright-statement</h3>
          <p>The &lt;copyright-statement&gt; element is used for the textual representation of
            copyright intended for print and display. It typically contains the copyright holder's
            name and the year among other information. This element appears within the
            &lt;permissions&gt; grouping element and is intended for the presentation of copyright
            information in a document. It can be used to clearly communicate specific copyright
            claims of a document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="copyright-year">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>copyright-year</h3>
          <p>Das Element &lt;copyright-year&gt; benennt das Urheberrechtsjahr eines Dokuments. Es
            dient hauptsaechlich der Metadatensuche und -aggregation und wird typischerweise nicht
            angezeigt. Dieses Element sollte mit dem Jahresinhalt der UrheberrechtserKlaerung
            uebereinstimmen, muss jedoch keine exakte Kopie sein. Es kann innerhalb des
            &lt;permissions&gt; Gruppierungselements vorkommen und unterstuetzt die praezise Angabe
            des Urheberrechtsjahres fuer Such- und Archivierungszwecke.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>copyright-year</h3>
          <p>The &lt;copyright-year&gt; element names the copyright year of a document. It is
            primarily intended for metadata searching and aggregation and is typically not
            displayed. This element should match the year content of the copyright statement but
            does not need to be an exact duplicate. It can appear within the &lt;permissions&gt;
            grouping element and supports the precise specification of the copyright year for search
            and archival purposes.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="copyright-holder">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>copyright-holder</h3>
          <p>Das Element &lt;copyright-holder&gt; gibt den Inhaber der Urheberrechte an einem
            Dokument an. Es ist ein wesentlicher Bestandteil der Urheberrechtsinformationen, die in
            der &lt;permissions&gt;-Sektion eines Dokuments angegeben werden. Dieses Element hilft
            dabei, die Urheberrechtsansprueche klar zu definieren und unterstuetzt die rechtliche
            Durchsetzung von Urheberrechten sowie die Lizenzierung und Nutzung von Inhalten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>copyright-holder</h3>
          <p>The &lt;copyright-holder&gt; element identifies the copyright owner of a document. It
            is a crucial part of the copyright information specified in the &lt;permissions&gt;
            section of a document. This element helps in clearly defining copyright claims and
            supports the legal enforcement of copyrights as well as the licensing and use of
            content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>


    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END PERMISSIONS AND COPYRIGHT -->


  <xsd:element name="abstract" type="abstractType">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>abstract</h3>
          <p>Das Element &lt;abstract&gt; dient der Bereitstellung einer Zusammenfassung des
            Dokumentinhalts. Es ist ein zentraler Bestandteil der Dokumentstruktur, der es Lesern
            ermoeglicht, schnell den Inhalt und Zweck eines Dokuments zu erfassen, ohne das gesamte
            Dokument lesen zu muessen. &lt;abstract&gt; kann innerhalb des
            &lt;article-meta&gt;-Elements erscheinen und ist besonders wichtig fuer die
            Auffindbarkeit und Indexierung in wissenschaftlichen Datenbanken.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>abstract</h3>
          <p>The &lt;abstract&gt; element provides a summary of the document content. It is a key
            part of the document structure, enabling readers to quickly grasp the content and
            purpose of a document without needing to read the entire text. &lt;abstract&gt; can
            appear within the &lt;article-meta&gt; element and is especially important for
            discoverability and indexing in academic databases.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>

  <xsd:element name="trans-abstract" type="abstractType">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>trans-abstract</h3>
          <p>Das Element &lt;trans-abstract&gt; enthaelt eine uebersetzte Version der
            Zusammenfassung eines Artikels, die in einer anderen Sprache als der Originalpublikation
            vorliegt. Es dient der Erweiterung der Zugaenglichkeit und Verstaendlichkeit von
            wissenschaftlichen Arbeiten fuer ein internationales Publikum. &lt;trans-abstract&gt;
            kann innerhalb des &lt;article-meta&gt;-Elements erscheinen und unterstuetzt die
            Mehrsprachigkeit in wissenschaftlichen Publikationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>trans-abstract</h3>
          <p>The &lt;trans-abstract&gt; element contains a translated version of an article's
            abstract, presented in a language different from that of the original publication. It
            aims to enhance the accessibility and comprehensibility of scientific works for an
            international audience. &lt;trans-abstract&gt; can appear within the
            &lt;article-meta&gt; element and supports multilingualism in scientific
            publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  
  <xsd:complexType name="abstractType">
    <xsd:sequence>
      <xsd:element ref="title" minOccurs="0"/>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element minOccurs="0" ref="p"/>
      </xsd:choice>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element minOccurs="0" ref="sec"/>
      </xsd:choice>
    </xsd:sequence>
    <xsd:attribute name="abstract-type">
      <xsd:simpleType>
        <xsd:restriction base="xsd:NCName">
          <xsd:enumeration value="short"/>
          <xsd:enumeration value="summary"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="id" use="optional" type="xsd:ID"/>
    <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
    <xsd:attribute ref="xml:base" use="optional"/>
    <xsd:attribute ref="xml:lang" use="optional"/>
  </xsd:complexType>
  <!-- END ABSTACT -->


  <!-- CUSTOM META -->
  <xsd:element name="custom-meta-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>custom-meta-group</h3>
          <p>Das Element &lt;custom-meta-group&gt; ist ein Container-Element fuer Metadaten, die
            sonst nicht in der Tag Suite definiert sind. Es dient der Aufnahme von einem oder
            mehreren &lt;custom-meta&gt;-Elementen, wobei jedes &lt;custom-meta&gt;-Element ein
            Name/Wert-Paar enthaelt, das einen einzelnen Metadateneintrag definiert. Dieses Element
            wurde in aktuellen Versionen des NISO JATS neu gestaltet, um eine bessere
            Rueckwaertskompatibilitaet und Flexibilitaet in der Handhabung benutzerdefinierter
            Metadaten zu bieten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>custom-meta-group</h3>
          <p>The &lt;custom-meta-group&gt; element is a container element for metadata not otherwise
            defined in the Tag Suite. It is designed to hold one or more &lt;custom-meta&gt;
            elements, each of which contains a name/value pair that defines a single metadata entry.
            This element has been significantly remodeled in the current versions of NISO JATS to
            provide better backward compatibility and flexibility in handling custom metadata.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="custom-meta" maxOccurs="unbounded"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="custom-meta">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>custom-meta</h3>
          <p>Das Element &lt;custom-meta&gt; dient der Definition benutzerdefinierter Metadaten
            innerhalb der JATS-Struktur. Es ermoeglicht die Spezifikation von Metadaten, die nicht
            durch die Standard-Elemente abgedeckt sind, und unterstuetzt so eine flexible
            Erweiterung der Metadateninformationen eines Dokuments. Jedes
            &lt;custom-meta&gt;-Element besteht aus einem &lt;meta-name&gt;- und einem
            &lt;meta-value&gt;-Element, die zusammen ein Name-Wert-Paar bilden, um spezifische
            Informationen zu definieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>custom-meta</h3>
          <p>The &lt;custom-meta&gt; element is used to define custom metadata within the JATS
            structure. It allows for the specification of metadata not covered by the standard
            elements, thus supporting a flexible extension of a document's metadata information.
            Each &lt;custom-meta&gt; element consists of a &lt;meta-name&gt; and a
            &lt;meta-value&gt; element, which together form a name-value pair to define specific
            information.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="meta-name"/>
        <xsd:element ref="meta-value"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="meta-name">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>meta-name</h3>
          <p>Das Element &lt;meta-name&gt; definiert den Namen eines Metadatenelements innerhalb
            eines &lt;custom-meta&gt;-Elements im JATS-Strukturkontext. Es dient dazu, den
            spezifischen Namen oder die Bezeichnung des benutzerdefinierten Metadateneintrags
            anzugeben, was eine flexible Anpassung und Erweiterung der Metadaten eines Dokuments
            ermoeglicht. &lt;meta-name&gt; wird typischerweise in Verbindung mit &lt;meta-value&gt;
            verwendet, um ein vollstaendiges Name-Wert-Paar fuer benutzerdefinierte Metadaten zu
            bilden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>meta-name</h3>
          <p>The &lt;meta-name&gt; element defines the name of a metadata element within a
            &lt;custom-meta&gt; element in the JATS structure context. It serves to specify the
            specific name or designation of the custom metadata entry, allowing for flexible
            customization and expansion of a document's metadata. &lt;meta-name&gt; is typically
            used in conjunction with &lt;meta-value&gt; to form a complete name-value pair for
            custom metadata.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="meta-value">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>meta-value</h3>
          <p>Das Element &lt;meta-value&gt; speichert den Wert eines Metadatenelements innerhalb
            eines &lt;custom-meta&gt;-Elements im JATS-Strukturkontext. Es dient zur Aufnahme des
            spezifischen Inhalts oder der Information, die dem durch &lt;meta-name&gt; definierten
            Namen zugeordnet ist. Dies ermoeglicht eine detaillierte Spezifikation von
            benutzerdefinierten Metadaten, die fuer die Beschreibung eines Dokuments erforderlich
            sind. &lt;meta-value&gt; kann Text, Zahlen oder andere relevante Daten enthalten, die
            zur weiteren Beschreibung des Metadateneintrags dienen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>meta-value</h3>
          <p>The &lt;meta-value&gt; element stores the value of a metadata element within a
            &lt;custom-meta&gt; element in the JATS structure context. It is used to hold the
            specific content or information associated with the name defined by &lt;meta-name&gt;.
            This allows for a detailed specification of custom metadata required for describing a
            document. &lt;meta-value&gt; can contain text, numbers, or other relevant data that
            serve to further describe the metadata entry.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <!-- JATS; diff to JATS, here no further structure allowed inside -->

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END CUSTOM META -->

  <!-- ============== END FRONT  ============== -->

  <!-- BODY -->
  <xsd:element name="body">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>body</h3>
          <p>Das Element &lt;body&gt; repraesentiert den Hauptinhalt eines Dokuments im
            JATS-Strukturkontext. Es umfasst den Kern der Arbeit, einschliesslich Text, Abbildungen,
            Tabellen und andere Elemente, die fuer das Verstaendnis des Themas wesentlich sind. Der
            &lt;body&gt; folgt typischerweise auf die Einleitung oder das Abstract und kann in
            Abschnitte unterteilt sein, die durch &lt;sec&gt;-Elemente dargestellt werden. Dieses
            Element ist entscheidend fuer die Strukturierung und Praesentation des Hauptinhalts
            eines wissenschaftlichen Artikels oder Berichts.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>body</h3>
          <p>The &lt;body&gt; element represents the main content of a document in the JATS
            structure context. It encompasses the core of the work, including text, figures, tables,
            and other elements essential for understanding the subject matter. The &lt;body&gt;
            typically follows the introduction or abstract and may be divided into sections
            represented by &lt;sec&gt; elements. This element is crucial for structuring and
            presenting the main content of a scientific article or report.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:group ref="para-level"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="sec"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END BODY -->



  <!-- BACK MATTER -->
  <xsd:element name="back">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>back</h3>
          <p>Das Element &lt;back&gt; dient zur Aufnahme von Inhalten, die sich klassischerweise im
            Anhang eines Artikels befinden, wie z.B. Appendix, Literaturverzeichnis oder Glossar. Im
            JATS-Strukturkontext folgt es nach dem Hauptinhalt des Artikels, repraesentiert durch
            das &lt;body&gt;-Element, und bietet Raum fuer ergaenzende Informationen, die fuer das
            Verstaendnis des Haupttextes nuetzlich oder notwendig sind. Es kann verschiedene Typen
            von hinteren Materialelementen enthalten, die zur weiteren Erlaeuterung des im Artikel
            behandelten Themas beitragen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>back</h3>
          <p>The &lt;back&gt; element is used to contain content that traditionally appears in the
            appendix of an article, such as appendices, references, or glossaries. In the JATS
            structure context, it follows the main content of the article, represented by the
            &lt;body&gt; element, and provides space for supplementary information that is useful or
            necessary for understanding the main text. It can include various types of back matter
            elements that contribute to further explanation of the topic discussed in the
            article.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="sec"/>
          <xsd:element ref="ack"/>
          <xsd:element ref="app-group"/>
          <xsd:element ref="bio"/>
          <xsd:element ref="glossary"/>
          <xsd:element ref="ref-list"/>
          <xsd:element ref="notes"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <!-- APPENDIX GROUP -->
  <xsd:element name="app-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>app-group</h3>
          <p>Das Element &lt;app-group&gt; wird verwendet, um eine Gruppe von Anhaengen
            (&lt;app&gt;) innerhalb eines JATS-dokumentierten Artikels zu gruppieren. Es dient der
            strukturierten Zusammenfassung mehrerer Anhaenge, die thematisch zusammengehoeren, und
            ermoeglicht eine uebersichtlichere Darstellung im hinteren Teil des Dokuments. Dies kann
            besonders nuetzlich sein, um umfangreiche Forschungsdaten, zusaetzliche Tabellen,
            ErKlaerungen oder methodische Details, die fuer das Hauptdokument zu umfangreich waeren,
            uebersichtlich zu organisieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>app-group</h3>
          <p>The &lt;app-group&gt; element is used to group a set of appendices (&lt;app&gt;) within
            a JATS-documented article. It serves to structurally summarize multiple appendices that
            are thematically related, allowing for a more organized presentation in the back matter
            of the document. This can be particularly useful for neatly organizing extensive
            research data, additional tables, explanations, or methodological details that would be
            too voluminous for the main document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="label"/>
            <xsd:element ref="title" minOccurs="0"/>
          </xsd:sequence>
          <xsd:element ref="title"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element maxOccurs="unbounded" ref="abstract"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element maxOccurs="unbounded" ref="kwd-group"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="fig"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
          <xsd:element ref="code"/>
          <xsd:element ref="table-wrap"/>
          <xsd:element ref="boxed-text"/>
          <xsd:element ref="disp-quote"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="fig-group"/>
          <xsd:element ref="table-wrap-group"/>
          <xsd:element ref="graphic"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element maxOccurs="unbounded" ref="app"/>
          <xsd:element maxOccurs="unbounded" ref="ref-list"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- APP APPENDIX -->
  <xsd:element name="app">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>app</h3>
          <p>Das Element &lt;app&gt; repraesentiert einen Anhang innerhalb der JATS-Struktur. Es
            wird verwendet, um zusaetzliche Informationen, Daten, Tabellen oder ErKlaerungen
            bereitzustellen, die fuer das Hauptdokument relevant sind, aber aufgrund ihrer
            Ausfuehrlichkeit oder Spezifitaet separat gehalten werden. Innerhalb der JATS-Struktur
            kann &lt;app&gt; in verschiedenen Teilen des Dokuments vorkommen, insbesondere im
            &lt;back&gt;-Bereich, um Anhaenge systematisch zu organisieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>app</h3>
          <p>The &lt;app&gt; element represents an appendix within the JATS structure. It is used to
            provide additional information, data, tables, or explanations that are relevant to the
            main document but are kept separate due to their length or specificity. Within the JATS
            structure, &lt;app&gt; can appear in various parts of the document, especially in the
            &lt;back&gt; section, to systematically organize appendices.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="sec-meta" minOccurs="0"/>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="label"/>
            <xsd:element ref="title" minOccurs="0"/>
          </xsd:sequence>
          <xsd:element ref="title"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="fig"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
          <xsd:element ref="code"/>
          <xsd:element ref="table-wrap"/>
          <xsd:element ref="boxed-text"/>
          <xsd:element ref="disp-quote"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="fig-group"/>
          <xsd:element ref="table-wrap-group"/>
          <xsd:element ref="graphic"/>
        </xsd:choice>
        <xsd:sequence minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="sec"/>
        </xsd:sequence>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="ref-list"/>
          <xsd:element ref="glossary"/>
        </xsd:choice>
        <xsd:element ref="permissions" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- REF LIST - REFERENCE LIST -->
  <!-- NO nested ref-list in ref-list -->
  <xsd:element name="ref-list">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;ref-list&gt;</h3>
          <p>Definiert eine Liste von Referenzen oder Zitaten im Artikel, die im &lt;back&gt;
            Element des JATS Dokuments vorkommen kann.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;ref-list&gt;</h3>
          <p>Defines a list of references or citations within the article, which can occur within
            the &lt;back&gt; element of the JATS document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:group ref="block-display.class"/>
          <xsd:element ref="disp-formula-group"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="inline-formula"/>
          <xsd:element ref="p"/>
          <xsd:element ref="related-article"/>
          <xsd:element ref="related-object"/>
        </xsd:choice>
        <xsd:element ref="ref" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:element ref="ref-list" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>


  <!-- Biography -->
  <xsd:element name="bio">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;bio&gt;</h3>
          <p>Definiert biografische Informationen eines Autors oder Beitragenden. Kann innerhalb des
            &lt;contrib&gt; Elements in den Frontmatter- oder Backmatter-Abschnitten eines
            JATS-Dokuments vorkommen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;bio&gt;</h3>
          <p>Defines biographical information of an author or contributor. It can occur within the
            &lt;contrib&gt; element in the frontmatter or backmatter sections of a JATS
            document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="sec-meta" minOccurs="0"/>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:group ref="block-display.class"/>
          <xsd:element ref="disp-formula-group"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="inline-formula"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
          <xsd:element ref="related-article"/>
          <xsd:element ref="related-object"/>
        </xsd:choice>
        <xsd:element ref="sec" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="glossary"/>
          <xsd:element ref="ref-list"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- RELATED ARTICLE / RELATED OBJECT -->
  <xsd:element name="related-article">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;related-article&gt;</h3>
          <p>Definiert eine Beziehung zu einem anderen Artikel, der in Bezug zum aktuellen Artikel
            steht. Dies kann in verschiedenen Teilen des JATS-Dokuments vorkommen, um Verbindungen
            zwischen verwandten Artikeln herzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;related-article&gt;</h3>
          <p>Defines a relationship to another article that is related to the current article. This
            can occur in various parts of the JATS document to establish connections between related
            articles.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:element ref="journal-id"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="references.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="ext-link-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="issue" use="optional" type="xsd:string"/>
      <xsd:attribute name="journal-id" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="vol" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="related-object">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;related-object&gt;</h3>
          <p>Definiert ein Objekt, das in Beziehung zum aktuellen Dokument oder Inhalt steht. Dies
            kann in verschiedenen Teilen des JATS-Dokuments vorkommen, um Verbindungen zu verwandten
            Objekten wie Datensaetzen, Software, Ergaenzungsmaterialien oder anderen relevanten
            Objekten herzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;related-object&gt;</h3>
          <p>Defines an object that is related to the current document or content. This can occur in
            various parts of the JATS document to establish connections to related objects such as
            datasets, software, supplementary materials, or other relevant objects.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="references.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="document-id" use="optional" type="xsd:string"/>
      <xsd:attribute name="ext-link-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="object-id" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>


  <!-- END RELATED ARTICLE / RELATED OBJECT -->


  <xsd:element name="ref">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;ref&gt;</h3>
          <p>Definiert einen Verweis innerhalb des JATS-Dokuments. Dies kann ein Zitat oder eine
            Quellenangabe sein, die auf eine externe Quelle oder auf ein anderes Element innerhalb
            des Dokuments verweist. &lt;ref&gt; Elemente sind wesentlich fuer die Erstellung von
            Bibliographien und fuer das Verweisen auf relevante Literatur oder andere Dokumente.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;ref&gt;</h3>
          <p>Defines a reference within the JATS document. This can be a citation or a source
            mention that points to an external source or to another element within the document.
            &lt;ref&gt; elements are essential for creating bibliographies and for referring to
            relevant literature or other documents.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element ref="element-citation"/>
          <xsd:element ref="mixed-citation"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="element-citation">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;element-citation&gt;</h3>
          <p>Definiert eine Zitation innerhalb des JATS-Dokuments, die ausschliesslich aus Elementen
            besteht, ohne innere Interpunktion oder Abstaende, und es erlaubt, die Bestandteile der
            Zitation in beliebiger Reihenfolge anzuordnen. &lt;element-citation&gt; ist fuer die
            Strukturierung von bibliografischen Verweisen innerhalb wissenschaftlicher Publikationen
            von zentraler Bedeutung.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;element-citation&gt;</h3>
          <p>Defines a citation within the JATS document that consists solely of elements, with no
            interior punctuation or spacing, allowing the components of the citation to be arranged
            in any order. &lt;element-citation&gt; is crucial for structuring bibliographic
            references within scholarly publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice>
          <xsd:element ref="person-group"/>
          <xsd:sequence>
            <xsd:element maxOccurs="unbounded" ref="name"/>
            <xsd:element ref="article-title"/>
            <xsd:element ref="trans-title"/>
          </xsd:sequence>
        </xsd:choice>
        <xsd:element ref="source"/>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="year"/>
            <xsd:element ref="month"/>
            <xsd:element ref="volume"/>
            <xsd:element ref="issue"/>
            <xsd:element ref="fpage"/>
            <xsd:element ref="lpage"/>
            <xsd:element ref="comment"/>
          </xsd:sequence>
          <xsd:sequence>
            <xsd:element ref="date"/>
            <xsd:element ref="publisher-loc"/>
            <xsd:element ref="publisher-name"/>
          </xsd:sequence>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="publication-format" use="required" type="xsd:NCName"/>
      <xsd:attribute name="publication-type" use="required" type="xsd:NCName"/>
    </xsd:complexType>
  </xsd:element>


  <xsd:element name="trans-title">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;trans-title&gt;</h3>
          <p>Definiert den uebersetzten Titel eines Dokuments oder Artikels innerhalb der
            JATS-Struktur. Der &lt;trans-title&gt; ist eine Version des Titels in einer anderen
            Sprache als der Originalsprache der Publikation. Dieses Element tritt haeufig in
            Verbindung mit &lt;trans-title-group&gt; auf, um uebersetzte Titel und Untertitel
            zusammenzuhalten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;trans-title&gt;</h3>
          <p>Defines the translated title of a document or article within the JATS structure. The
            &lt;trans-title&gt; is a version of the title in a language other than the original
            language of publication. This element often appears in conjunction with
            &lt;trans-title-group&gt; to hold translated titles and subtitles together.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:attribute ref="xml:lang" use="required"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="volume" type="xsd:integer">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;volume&gt;</h3>
          <p>Bezeichnet den Band einer Publikation innerhalb der JATS-Struktur. Der
            &lt;volume&gt;-Element wird verwendet, um die Bandnummer einer Zeitschrift oder einer
            Buchreihe anzugeben. Dies ist besonders wichtig fuer die eindeutige Identifizierung von
            Publikationen innerhalb einer Serie oder eines Zeitschriftenabonnements.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;volume&gt;</h3>
          <p>Denotes the volume of a publication within the JATS structure. The &lt;volume&gt;
            element is used to specify the volume number of a journal or a series of books. This is
            particularly important for the unique identification of publications within a series or
            a journal subscription.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="issue" type="xsd:integer">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;issue&gt;</h3>
          <p>Bezeichnet die Ausgabennummer einer Publikation innerhalb der JATS-Struktur. Das
            &lt;issue&gt;-Element wird verwendet, um die spezifische Ausgabe einer Zeitschrift oder
            eines Sammelwerks zu identifizieren, in der ein Artikel erschienen ist. Es findet sowohl
            in den Metadaten des Artikels (&lt;article-meta&gt;) als auch in bibliografischen
            Referenzen (&lt;element-citation&gt; und &lt;mixed-citation&gt;) Anwendung, um die
            Ausgabe zu spezifizieren, in der das zitierte Material veroeffentlicht wurde. Bei
            gemeinsamen Ausgaben, die mehr als eine Ausgabennummer umfassen, werden alle relevanten
            Nummern in einem einzigen &lt;issue&gt;-Element zusammengefasst.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;issue&gt;</h3>
          <p>Denotes the issue number of a publication within the JATS structure. The &lt;issue&gt;
            element is used to identify the specific issue of a journal or collected work in which
            an article appeared. It is used both in the article's metadata (&lt;article-meta&gt;)
            and in bibliographic references (&lt;element-citation&gt; and &lt;mixed-citation&gt;) to
            specify the issue in which the cited material was published. For joint issues that
            encompass more than one issue number, all relevant numbers are consolidated into a
            single &lt;issue&gt; element.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="fpage" type="xsd:integer">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;fpage&gt;</h3>
          <p>Bezeichnet die erste Seite eines Dokuments innerhalb der JATS-Struktur. Das
            &lt;fpage&gt;-Element wird in zwei Kontexten verwendet: 1. Als Teil der Metadaten, die
            den Artikel selbst betreffen, und 2. Als Teil der bibliografischen Referenzmetadaten
            innerhalb bibliografischer Referenzen (&lt;element-citation&gt; und
            &lt;mixed-citation&gt;). Elektronische Zeitschriften, die traditionell keine
            Seitenzahlen verwenden, nutzen stattdessen das &lt;elocation-id&gt;-Element anstelle der
            &lt;fpage&gt; oder &lt;lpage&gt; Elemente.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;fpage&gt;</h3>
          <p>Denotes the first page of a document within the JATS structure. The &lt;fpage&gt;
            element is used in two contexts: 1. As part of the metadata concerning the article
            itself, and 2. As part of bibliographic reference metadata within bibliographic
            references (&lt;element-citation&gt; and &lt;mixed-citation&gt;). Electronic-only
            journals, which traditionally do not use page numbers, instead use the
            &lt;elocation-id&gt; element in place of the &lt;fpage&gt; or &lt;lpage&gt;
            elements.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="lpage" type="xsd:integer">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;lpage&gt;</h3>
          <p>Bezeichnet die letzte Seite eines Dokuments innerhalb der JATS-Struktur. Das
            &lt;lpage&gt;-Element wird haeufig in Verbindung mit dem &lt;fpage&gt;-Element
            verwendet, um den Seitenbereich eines Artikels oder eines Beitrags in einem Band oder
            einer Zeitschrift anzugeben. Es findet sowohl in den Artikelmetadaten als auch in den
            Referenzmetadaten Verwendung.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;lpage&gt;</h3>
          <p>Denotes the last page of a document within the JATS structure. The &lt;lpage&gt;
            element is often used in conjunction with the &lt;fpage&gt; element to indicate the page
            range of an article or a contribution in a volume or journal. It is used both in the
            article metadata and in the reference metadata.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
  </xsd:element>
  <xsd:element name="comment" type="xsd:string"/>
  <xsd:element name="mixed-citation">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;mixed-citation&gt;</h3>
          <p>Bezeichnet eine Zitierweise innerhalb der JATS-Struktur, bei der die Zitation textuell
            erfolgt, mit Erhalt aller inneren Interpunktionen und Leerzeichen. Dies ermoeglicht es,
            die Komponenten der Zitation in beliebiger Reihenfolge anzuordnen. Das
            &lt;mixed-citation&gt;-Element wird haeufig in Literaturverzeichnissen verwendet, um
            eine flexible Darstellung von Referenzen zu ermoeglichen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;mixed-citation&gt;</h3>
          <p>Denotes a citation style within the JATS structure where the citation is textual,
            preserving all internal punctuation and spaces. This allows the components of the
            citation to be arranged in any order. The &lt;mixed-citation&gt; element is often used
            in bibliographies to allow for a flexible presentation of references.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="date"/>
        <xsd:element ref="person-group"/>
        <xsd:element ref="publisher-loc"/>
        <xsd:element ref="publisher-name"/>
        <xsd:element ref="source"/>
        <xsd:group ref="emphasis.class"/>        
        <xsd:group ref="subsup.class"/>
        <xsd:element ref="ext-link"/>
        <xsd:element ref="uri"/>
        <xsd:element ref="xref"/>
        <xsd:element ref="named-content"/>
        <xsd:element ref="styled-content"/>        
      </xsd:choice>
      <xsd:attribute name="publication-format" use="optional" type="xsd:NCName"/>
      <xsd:attribute name="publication-type" use="optional" type="xsd:NCName"/>
      <xsd:attribute name="hreflang" use="optional" type="xsd:NMTOKEN"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>

  <!-- ACKNOWLEDGEMENT -->
  <xsd:element name="ack">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;ack&gt;</h3>
          <p>Das Element &lt;ack&gt; wird verwendet, um Danksagungen innerhalb eines
            JATS-dokumentierten Artikels zu kennzeichnen. Es kann Anerkennungen fuer finanzielle
            unterstuetzung, Beitraege von Kollegen oder andere Formen der unterstuetzung enthalten,
            die nicht direkt zu den Hauptautoren des Dokuments gehoeren. Die Verwendung dieses
            Elements ermoeglicht eine klare Trennung von inhaltlichen und anerkennenden
            Textteilen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;ack&gt;</h3>
          <p>The &lt;ack&gt; element is used to denote acknowledgements within a JATS-documented
            article. It may contain acknowledgements for financial support, contributions from
            colleagues, or other forms of support that do not directly belong to the main authors of
            the document. Utilizing this element allows for a clear separation between content and
            acknowledgements text parts.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title"/>
        <xsd:element ref="p" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- GLOSSARY -->
  <xsd:element name="glossary">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;glossary&gt;</h3>
          <p>Das Element &lt;glossary&gt; wird verwendet, um einen Glossarteil innerhalb eines
            JATS-dokumentierten Artikels zu definieren. Es dient der Auflistung von Begriffen und
            deren Definitionen, ueblicherweise im hinteren Teil des Dokuments. Ein &lt;glossary&gt;
            kann einfach gestaltet sein mit nur einem Titel und einer &lt;def-list&gt;, oder
            komplexer mit mehreren Begriffslisten, die jeweils durch einen Titel fuer die
            spezifische Zielgruppe gekennzeichnet sind. Glossare in JATS sind rekursiv, was
            bedeutet, dass ein &lt;glossary&gt; Element weitere &lt;glossary&gt; Elemente enthalten
            kann.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;glossary&gt;</h3>
          <p>The &lt;glossary&gt; element is used to define a glossary section within a
            JATS-documented article. It serves to list terms and their definitions, typically found
            in the back matter of the document. A &lt;glossary&gt; can be simple, containing only a
            title and a &lt;def-list&gt;, or more complex, divided into several lists of terms, each
            headed by a title that describes the audience for the particular terms. Glossaries in
            JATS are recursive, meaning a &lt;glossary&gt; element can contain other
            &lt;glossary&gt; elements.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:group ref="block-display.class"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="disp-formula-group"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <!-- NOTES - in BACKMATTER -->
  <xsd:element name="notes">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;notes&gt;</h3>
          <p>Das Element &lt;notes&gt; wird in JATS-Dokumenten verwendet, um Anmerkungen oder
            Fussnoten zu kennzeichnen, die zusaetzliche Informationen oder Erlaeuterungen zum
            Haupttext bieten. Diese koennen innerhalb verschiedener Teile des Dokuments auftreten,
            wie z.B. innerhalb von &lt;body&gt;, &lt;back&gt; oder &lt;front&gt; Abschnitten, um
            Lesern weiterfuehrende Details zu praesentieren, die fuer das Verstaendnis des Textes
            hilfreich sein koennen, aber nicht unmittelbar im Haupttext enthalten sind.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;notes&gt;</h3>
          <p>The &lt;notes&gt; element is used in JATS documents to denote annotations or footnotes
            that provide additional information or clarifications to the main text. These can occur
            within various parts of the document, such as within &lt;body&gt;, &lt;back&gt;, or
            &lt;front&gt; sections, to offer readers further details that may aid in understanding
            the text but are not directly included in the main narrative.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="title"/>
        <xsd:element ref="p" maxOccurs="unbounded"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- SOURCE (REFERENCE SOURCE) -->
  <xsd:element name="source">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;source&gt;</h3>
          <p>Das Element &lt;source&gt; wird in JATS-Dokumenten verwendet, um die Quelle eines
            Zitats oder einer Referenz anzugeben. Es kann innerhalb von bibliografischen Elementen
            wie &lt;ref&gt; auftreten, um den Ursprung der zitierten oder referenzierten Information
            zu kennzeichnen. Dies ermoeglicht eine genaue Zuordnung von Quellenangaben und
            unterstuetzt die Nachvollziehbarkeit wissenschaftlicher Arbeiten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;source&gt;</h3>
          <p>The &lt;source&gt; element is used in JATS documents to specify the source of a
            citation or reference. It can appear within bibliographic elements like &lt;ref&gt; to
            denote the origin of the cited or referenced information. This facilitates accurate
            attribution of sources and supports the traceability of scholarly works.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:element ref="inline-graphic"/>
        <xsd:element ref="disp-formula-group"/>
        <xsd:element ref="disp-formula"/>
        <xsd:element ref="inline-formula"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:element ref="fn"/>
        <xsd:element ref="xref"/>
        <xsd:element ref="ext-link"/>
        <xsd:element ref="uri"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>




  <!-- CONTRIB GROUP -->
  <xsd:element name="contrib-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;contrib-group&gt;</h3>
          <p>Das Element &lt;contrib-group&gt; dient als Container fuer eine oder mehrere
            Beitragende und Informationen ueber diese Beitragenden. Es wird primaer innerhalb des
            Elements &lt;article-meta&gt; verwendet, um Beitragende zu einem Dokument wie
            Hauptautoren, Datenkuratoren, Herausgeber, Sponsoren, uebersetzer, Illustratoren usw. zu
            erfassen. Die Mitglieder der Gruppe sind Beitragende, die individuell gearbeitet haben,
            nicht als Gruppe. Innerhalb des Elements &lt;journal-meta&gt; haelt das
            &lt;contrib-group&gt; Element Beitragende auf einer uebergeordneten Ebene fest, wie
            Abschnittsredakteure, Zeitschriftenredakteure oder Herausgeber von Sonderausgaben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;contrib-group&gt;</h3>
          <p>The &lt;contrib-group&gt; element serves as a container for one or more contributors
            and information about those contributors. It is primarily used within the
            &lt;article-meta&gt; element to hold contributors to a document such as primary authors,
            data curators, editors, sponsors, translators, illustrators, etc. The members of the
            group are contributors who worked individually, not as a group. Within the
            &lt;journal-meta&gt; element, the &lt;contrib-group&gt; element holds contributors at a
            level above that of an individual article, such as section editors, journal editors, or
            special issue editors.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" ref="contrib"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- CONTRIB -->
  <xsd:element name="contrib">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;contrib&gt;</h3>
          <p>Das Element &lt;contrib&gt; repraesentiert einen Beitragenden innerhalb der
            JATS-Struktur. Es wird typischerweise innerhalb des &lt;contrib-group&gt;-Elements
            verwendet, um detaillierte Informationen ueber die einzelnen Autoren, Herausgeber oder
            andere Arten von Beitragenden zu einem wissenschaftlichen Artikel oder Dokument zu
            erfassen. Dies umfasst Namen, Affiliationen, Rollen und weitere spezifische
            Beitragsdetails. Das &lt;contrib&gt;-Element ermoeglicht eine flexible Darstellung
            verschiedener Beitragender und deren Beitraege zur Arbeit.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;contrib&gt;</h3>
          <p>The &lt;contrib&gt; element represents a contributor within the JATS structure. It is
            typically used within the &lt;contrib-group&gt; element to capture detailed information
            about individual authors, editors, or other types of contributors to a scholarly article
            or document. This includes names, affiliations, roles, and other specific contribution
            details. The &lt;contrib&gt; element allows for a flexible representation of various
            contributors and their contributions to the work.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice>
        <xsd:sequence>
        <xsd:element ref="contrib-id" minOccurs="0"/>
        <xsd:element ref="name"/>
        <xsd:element ref="aff" minOccurs="0"/>
        <xsd:element ref="bio" minOccurs="0"/>
        <xsd:element ref="email" minOccurs="0"/>        	
        <xsd:element ref="ext-link" minOccurs="0"/>        	
        <xsd:element ref="xref" minOccurs="0"/>
        </xsd:sequence>
      </xsd:choice>
      <xsd:attribute name="contrib-type" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:token">
            <xsd:enumeration value="Autor"/>
            <xsd:enumeration value="Co-Autor"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- CONTRIB-ID -->
  <xsd:element name="contrib-id">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>&lt;contrib-id&gt;</h3>
          <p>Das Element &lt;contrib-id&gt; dient zur Identifikation von Beitragenden innerhalb der
            JATS-Struktur. Es kann verwendet werden, um eindeutige Identifikatoren wie ORCID iDs den
            Autoren oder anderen Beitragenden eines wissenschaftlichen Artikels zuzuordnen. Die
            Nutzung dieses Elements erleichtert die eindeutige Zuordnung von Werken zu ihren
            Urhebern und unterstuetzt die Vernetzung wissenschaftlicher Informationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>&lt;contrib-id&gt;</h3>
          <p>The &lt;contrib-id&gt; element is used for the identification of contributors within
            the JATS structure. It can be used to assign unique identifiers such as ORCID iDs to
            authors or other contributors of a scholarly article. Utilizing this element facilitates
            the unique attribution of works to their creators and supports the networking of
            scientific information.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  <!-- AFF -->
  <xsd:element name="aff">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Zugehörigkeit (Affiliation)</h3>
          <p>Name einer Einrichtung oder Organisation (z. B. Universität, Unternehmen), der ein Mitwirkender angehört.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Affiliation</h3>
          <p>Name of an institution or organization (for example, university, corporation) with 
            which a contributor is affiliated.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded"/>
    </xsd:complexType>
  </xsd:element>
  


  <!-- INSTITUTION -->
  <xsd:element name="institution">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>institution</h3>
          <p>Bezeichnet den Namen einer Institution, die innerhalb der JATS-Struktur in
            Adressangaben vorkommen kann. Die &lt;institution&gt; Elemente koennen in verschiedenen
            Kontexten auftreten, um institutionelle Zugehoerigkeiten zu spezifizieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>institution</h3>
          <p>Denotes the name of an institution that can appear within the JATS structure in address
            details. The &lt;institution&gt; elements can occur in various contexts to specify
            institutional affiliations.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:role" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- ADDR-LINE -->
  <xsd:element name="addr-line">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>addr-line</h3>
          <p>Bezeichnet eine Zeile einer Adresse, die innerhalb der JATS-Struktur verwendet wird, um
            spezifische Adressdetails wie Strasse, Stadt oder Postleitzahl anzugeben. Das
            &lt;addr-line&gt; Element kann in verschiedenen Teilen der Struktur auftreten, um
            detaillierte Adressinformationen bereitzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>addr-line</h3>
          <p>Denotes a line of an address used within the JATS structure to specify specific address
            details such as street, city, or postal code. The &lt;addr-line&gt; element can occur in
            various parts of the structure to provide detailed address information.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="city"/>
        <xsd:element ref="fax"/>
        <xsd:element ref="institution"/>
        <xsd:element ref="phone"/>
        <xsd:element ref="postal-code"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="postal-code">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>postal-code</h3>
          <p>Bezeichnet die Postleitzahl innerhalb einer Adresse in der JATS-Struktur. Das
            &lt;postal-code&gt; Element kann in Adressangaben verwendet werden, um die geografische
            Zuordnung einer Adresse genauer zu spezifizieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>postal-code</h3>
          <p>Denotes the postal code within an address in the JATS structure. The
            &lt;postal-code&gt; element can be used in address details to more precisely specify the
            geographical allocation of an address.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="city">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>city</h3>
          <p>Bezeichnet die Stadt innerhalb einer Adresse in der JATS-Struktur. Das &lt;city&gt;
            Element kann in Adressangaben verwendet werden, um den staedtischen Teil einer Adresse
            zu spezifizieren. Es spielt eine wichtige Rolle bei der genauen Lokalisierung von
            Institutionen oder Personen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>city</h3>
          <p>Denotes the city within an address in the JATS structure. The &lt;city&gt; element can
            be used in address details to specify the urban part of an address. It plays a crucial
            role in accurately locating institutions or individuals.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>


    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="phone">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>phone</h3>
          <p>Bezeichnet die Telefonnummer innerhalb einer Adresse in der JATS-Struktur. Das
            &lt;phone&gt; Element kann in Adressangaben verwendet werden, um die telefonische
            Erreichbarkeit einer Person oder Institution anzugeben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>phone</h3>
          <p>Denotes the phone number within an address in the JATS structure. The &lt;phone&gt;
            element can be used in address details to specify the telephone contact information of
            an individual or institution.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="fax">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>fax</h3>
          <p>Bezeichnet die Faxnummer innerhalb einer Adresse in der JATS-Struktur. Das &lt;fax&gt;
            Element kann in Adressangaben verwendet werden, um die Fax-Erreichbarkeit einer Person
            oder Institution anzugeben. Dies ermoeglicht eine alternative Form der schriftlichen
            Kommunikation.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>fax</h3>
          <p>Denotes the fax number within an address in the JATS structure. The &lt;fax&gt; element
            can be used in address details to specify the fax contact information of an individual
            or institution. This provides an alternative means of written communication.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="email">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>email</h3>
          <p>Bezeichnet die E-Mail-Adresse in der JATS-Struktur. Das &lt;email&gt; Element kann
            verwendet werden, um die elektronische Kontaktinformation einer Person oder Institution
            anzugeben. Es ermoeglicht eine direkte und effiziente Form der Kommunikation.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>email</h3>
          <p>Denotes the email address within the JATS structure. The &lt;email&gt; element can be
            used to provide the electronic contact information of an individual or institution. It
            facilitates direct and efficient communication.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:role" use="optional"/>
      <xsd:attribute ref="xlink:show" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xlink:type" use="optional" fixed="simple"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="uri">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>uri</h3>
          <p>Bezeichnet eine einheitliche Ressourcen-Identifikator (Uniform Resource Identifier) in
            der JATS-Struktur. Das &lt;uri&gt; Element kann verwendet werden, um auf eine externe
            Ressource zu verweisen, wie z.B. eine Webseite, ein Dokument oder eine andere
            Online-Ressource. Es ermoeglicht die Verlinkung und den Zugriff auf zusaetzliche
            Informationen oder Dienste.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>uri</h3>
          <p>Denotes a Uniform Resource Identifier in the JATS structure. The &lt;uri&gt; element
            can be used to reference an external resource, such as a website, document, or other
            online resource. It facilitates linking to and accessing additional information or
            services.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>




  <xsd:element name="self-uri">
    <xsd:annotation>
      <xsd:documentation>
        <div xmlns="http://www.w3.org/1999/xhtml">
          <h3>Uri For This Same Article Online</h3>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="hreflang" use="optional" type="xsd:NMTOKEN"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:show" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <!-- SEC SECTION -->
  <xsd:element name="sec">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>sec</h3>
          <p>Das Element &lt;sec&gt; wird zur Strukturierung der Inhalte innerhalb des &lt;body&gt;
            verwendet, insbesondere wenn eine Ueberschrift/Zaehlung vorhanden ist. Es ermoeglicht
            die Organisation des Hauptinhalts in Abschnitte, die sich ineinander verschachteln
            lassen, um eine hierarchische Gliederung des Dokuments zu erreichen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>sec</h3>
          <p>The &lt;sec&gt; element is used to structure the content within the &lt;body&gt;,
            especially when a heading/count is present. It allows for the organization of the main
            content into sections that can be nested within each other, achieving a hierarchical
            organization of the document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" ref="sec-meta"/>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="label"/>
            <xsd:element ref="title" minOccurs="0"/>
          </xsd:sequence>
          <xsd:element ref="title"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="fig"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
          <xsd:element ref="code"/>
          <xsd:element ref="table-wrap"/>
          <xsd:element ref="boxed-text"/>
          <xsd:element ref="disp-quote"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="fig-group"/>
          <xsd:element ref="table-wrap-group"/>
          <xsd:element ref="graphic"/>
        </xsd:choice>
        <xsd:sequence minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="sec"/>
        </xsd:sequence>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="ref-list"/>
          <xsd:element ref="glossary"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="id" type="xsd:ID"/>
      <xsd:attribute name="sec-type" type="xsd:NCName"/>
      <xsd:attribute name="specific-use" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>

  <!-- BOXED TEXT -->
  <xsd:element name="boxed-text">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>boxed-text</h3>
          <p>Das Element &lt;boxed-text&gt; wird verwendet, um Text innerhalb eines Dokuments
            hervorzuheben, der in einem separaten Rahmen oder Kasten angezeigt werden soll. Dies
            kann fuer Warnungen, Hinweise oder zusaetzliche Informationen genutzt werden, die
            visuell vom restlichen Inhalt abgehoben werden sollen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>boxed-text</h3>
          <p>The &lt;boxed-text&gt; element is used to highlight text within a document that is to
            be displayed in a separate frame or box. This can be used for warnings, notes, or
            additional information that should be visually distinguished from the rest of the
            content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" ref="sec-meta"/>
        <xsd:sequence>
          <xsd:element ref="label" minOccurs="0"/>
          <xsd:element ref="caption" minOccurs="0"/>
          <xsd:choice minOccurs="0" maxOccurs="unbounded">
            <xsd:element ref="fig"/>
            <xsd:element ref="fig-group"/>
            <xsd:element ref="graphic"/>
            <xsd:element ref="media"/>
            <xsd:element ref="preformat"/>
            <xsd:element ref="table-wrap"/>
            <xsd:element ref="table-wrap-group"/>
            <xsd:element ref="disp-formula"/>
            <xsd:element ref="disp-formula-group"/>
            <xsd:element ref="disp-quote"/>
            <xsd:element ref="list"/>
            <xsd:element ref="def-list"/>
            <xsd:element ref="p"/>
            <xsd:element ref="mml:math"/>
            <xsd:element ref="boxed-text"/>
          </xsd:choice>
        </xsd:sequence>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="required">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NCName">
            <xsd:enumeration value="Hinweis"/>
            <xsd:enumeration value="oct_ext_Blau"/>
            <xsd:enumeration value="oct_ext_Gruen"/>
            <xsd:enumeration value="oct_ext_Grau"/>
            <xsd:enumeration value="oct_ext_Rot"/>
            <xsd:enumeration value="oct_ext_BR-Hinweis"/>
            <xsd:enumeration value="oct_ext_Literaturhinweis"/>
            <xsd:enumeration value="oct_ext_Norm-Auszug"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="id" type="xsd:ID"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="specific-use" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>
  
  <xsd:attributeGroup name="orientationPosition">
    <xsd:attribute name="orientation" use="optional">
      <xsd:simpleType>
        <xsd:restriction base="xsd:NCName">
          <xsd:enumeration value="landscape"/>
          <xsd:enumeration value="portrait"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
    <xsd:attribute name="position" use="optional">
      <xsd:simpleType>
        <xsd:restriction base="xsd:NCName">
          <xsd:enumeration value="float"/>
          <xsd:enumeration value="anchor"/>
          <xsd:enumeration value="background"/>
          <xsd:enumeration value="margin"/>
        </xsd:restriction>
      </xsd:simpleType>
    </xsd:attribute>
  </xsd:attributeGroup>

  <!-- DISP-QUOTE -->
  <xsd:element name="disp-quote">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>disp-quote</h3>
          <p>Das Element &lt;disp-quote&gt; wird verwendet, um Zitate oder Textauszuege innerhalb
            eines Dokuments hervorzuheben. Diese koennen fuer direkte Zitate, Blockzitate oder
            Textauszuege genutzt werden, die sich vom Haupttext abheben sollen. &lt;disp-quote&gt;
            kann in verschiedenen Teilen des Dokuments auftreten, einschliesslich innerhalb von
            &lt;sec&gt; Elementen, um eine strukturierte und visuell differenzierte Darstellung von
            Zitaten zu ermoeglichen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>disp-quote</h3>
          <p>The &lt;disp-quote&gt; element is used to highlight quotes or text excerpts within a
            document. It can be used for direct quotes, block quotes, or excerpts that are meant to
            stand out from the main text. &lt;disp-quote&gt; can occur in various parts of the
            document, including within &lt;sec&gt; elements, to allow for a structured and visually
            differentiated presentation of quotes.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="title" minOccurs="0"/>
        <xsd:choice minOccurs="1" maxOccurs="unbounded">
          <xsd:element ref="fig"/>
          <xsd:element ref="list"/>
          <xsd:element ref="def-list"/>
          <xsd:element ref="p"/>
          <xsd:element ref="code"/>
          <xsd:element ref="table-wrap"/>
          <xsd:element ref="boxed-text"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="fig-group"/>
          <xsd:element ref="table-wrap-group"/>
          <xsd:element ref="graphic"/>
        </xsd:choice>
        <xsd:element ref="attrib" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:NMTOKEN"/>
      <xsd:attribute name="specific-use" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- ATTRIBUTION -->
  <xsd:element name="attrib">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>attrib</h3>
          <p>Das Element &lt;attrib&gt; wird verwendet, um eine Zuschreibung oder Attribution
            innerhalb eines JATS-Dokuments anzugeben. Es kann beispielsweise innerhalb von
            &lt;disp-quote&gt; oder &lt;fig&gt; Elementen auftreten, um den Urheber oder die Quelle
            des zitierten oder dargestellten Inhalts zu kennzeichnen. &lt;attrib&gt; ermoeglicht
            eine formale Anerkennung von Urheberrechten oder Beitraegen in wissenschaftlichen
            Publikationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>attrib</h3>
          <p>The &lt;attrib&gt; element is used to specify an attribution or credit within a JATS
            document. It can appear, for example, within &lt;disp-quote&gt; or &lt;fig&gt; elements
            to denote the author or source of the quoted or depicted content. &lt;attrib&gt; allows
            for the formal acknowledgment of copyrights or contributions in scholarly
            publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:simpleContent>
        <xsd:extension base="xsd:string">
          <xsd:attribute name="specific-use" use="required">
            <xsd:simpleType>
              <xsd:restriction base="xsd:NMTOKEN">
                <xsd:enumeration value="_4octextparaZitat-Autor"/>
                <xsd:enumeration value="_4octextparaZitat-Werk"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:attribute>
        </xsd:extension>
      </xsd:simpleContent>
    </xsd:complexType>
  </xsd:element>

  <!-- FIG-GROUP -->
  <xsd:element name="fig-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>fig-group</h3>
          <p>Das Element &lt;fig-group&gt; dient als Container fuer Abbildungen, die zusammen angezeigt
            werden sollen. Es ermoeglicht die Gruppierung mehrerer &lt;fig&gt; Elemente, um diese
            als zusammengehoerig zu kennzeichnen. Dies kann beispielsweise fuer die Darstellung von
            Bilderserien oder grafischen Vergleichen innerhalb eines wissenschaftlichen Artikels
            genutzt werden. &lt;fig-group&gt; unterstuetzt auch die Verwendung von Attributen zur
            Angabe der Positionierung und kann mehrsprachige Beschriftungen und Bildunterschriften
            enthalten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>fig-group</h3>
          <p>The &lt;fig-group&gt; element serves as a container for figures that are to be
            displayed together. It allows for the grouping of multiple &lt;fig&gt; elements to mark
            them as related. This can be used, for example, for the presentation of series of images
            or graphical comparisons within a scientific article. &lt;fig-group&gt; also supports
            the use of attributes to indicate positioning and can contain multilingual labels and
            captions.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:sequence minOccurs="0">
          <xsd:element ref="label"/>
        </xsd:sequence>
        <xsd:sequence minOccurs="0">
          <xsd:element ref="caption"/>
        </xsd:sequence>
        <xsd:sequence minOccurs="0">
          <xsd:element ref="alt-text"/>
        </xsd:sequence>
        <xsd:choice minOccurs="2" maxOccurs="unbounded">
          <xsd:element ref="fig"/>
          <xsd:element ref="graphic"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attributeGroup ref="orientationPosition"/>
    </xsd:complexType>
  </xsd:element>





  <!-- KEWYWORDS -->
  <xsd:element name="kwd-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>kwd-group</h3>
          <p>Das Element &lt;kwd-group&gt; wird verwendet, um eine Gruppe von Schlagwoertern
            (Keywords) innerhalb eines JATS-Dokuments zu definieren. Diese Schlagwoerter dienen der
            inhaltlichen Erschliessung und verbessern die Auffindbarkeit des Dokuments in
            Datenbanken und Suchmaschinen. &lt;kwd-group&gt; kann in verschiedenen Teilen des
            Dokuments, wie dem &lt;front&gt;-Bereich eines Artikels, auftreten und unterstuetzt die
            Zuordnung von Schlagwoertern zu spezifischen Artikelsektionen oder Themen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>kwd-group</h3>
          <p>The &lt;kwd-group&gt; element is used to define a group of keywords within a JATS
            document. These keywords facilitate content indexing and enhance the document's
            discoverability in databases and search engines. &lt;kwd-group&gt; can appear in various
            parts of the document, such as the &lt;front&gt; area of an article, and supports the
            association of keywords with specific article sections or topics.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="kwd" maxOccurs="unbounded"/>
        <xsd:element ref="nested-kwd"/>
      </xsd:choice>
      <xsd:attribute name="specific-use" type="xsd:string"/>
      <xsd:attribute name="kwd-group-type">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="author-generated"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute ref="xml:lang"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="nested-kwd">

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="kwd"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="kwd">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>kwd</h3>
          <p>Das Element &lt;kwd&gt; dient zur Angabe eines Schlagwortes innerhalb einer
            &lt;kwd-group&gt;. Schlagworte helfen bei der inhaltlichen Erschliessung und verbessern
            die Auffindbarkeit des Dokuments in Datenbanken und Suchmaschinen. Schlagworte muessen
            nach Sprache getrennt und in entsprechenden Sprachgruppen platziert werden, da das
            &lt;kwd&gt;-Element das Attribut @xml:lang nicht aufnehmen kann; dieses ist fuer die
            &lt;kwd-group&gt; reserviert.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>kwd</h3>
          <p>The &lt;kwd&gt; element is used to specify a keyword within a &lt;kwd-group&gt;.
            Keywords facilitate content indexing and enhance the document's discoverability in
            databases and search engines. Keywords must be separated by language and placed into
            corresponding language groups, as the &lt;kwd&gt; element cannot take the @xml:lang
            attribute; this is reserved for the &lt;kwd-group&gt;.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END KEYWORDS -->


  <!-- PARAGRAPH -->
  <xsd:element name="p">

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="fig"/>
        <xsd:element ref="inline-formula"/>
        <xsd:element ref="disp-formula"/>
        <xsd:element ref="list"/>
        <xsd:element ref="def-list"/>
        <xsd:element ref="uri"/>
        <xsd:element ref="ext-link"/>
        <xsd:element ref="inline-graphic"/>
        <xsd:element ref="preformat"/>
        <xsd:element ref="table-wrap"/>
        <xsd:element ref="xref"/>
        <xsd:element ref="fn"/>
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="subsup.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:element ref="boxed-text"/>
      </xsd:choice>
      <xsd:attribute name="content-type" type="xsd:string"/>
      <xsd:attribute name="id" type="xsd:ID"/>
      <xsd:attribute name="specific-use" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END PARAGRAPH -->

  <!-- EXT LINK -->
  <xsd:element name="ext-link">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>ext-link</h3>
          <p>Das Element &lt;ext-link&gt; wird verwendet, um einen externen Link zu definieren. Es
            kann innerhalb verschiedener Kontexte in der JATS-Struktur auftreten, um auf externe
            Ressourcen, wie Dokumente oder Webseiten, zu verweisen. ueber das Attribut
            @ext-link-type kann der Typ des Links spezifiziert werden, und das Attribut @xlink:href
            dient zur Angabe der URL der externen Ressource.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>ext-link</h3>
          <p>The &lt;ext-link&gt; element is used to define an external link. It can occur within
            various contexts in the JATS structure to refer to external resources, such as documents
            or websites. The @ext-link-type attribute can specify the type of link, and the
            @xlink:href attribute is used to provide the URL of the external resource.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="link-elements"/>
      </xsd:choice>
      <xsd:attribute name="assigning-authority" use="optional" type="xsd:string"/>
      <xsd:attribute name="ext-link-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="hreflang" use="optional" type="xsd:NMTOKEN"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xlink:show" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END EXT LINK -->


  <!-- PREFORMAT -->
  <xsd:element name="preformat">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>preformat</h3>
          <p>Das Element &lt;preformat&gt; wird verwendet, um Text darzustellen, der in einer
            vorformatierten Weise, wie Code oder Tabellen, angezeigt werden soll. Es behaelt die
            Formatierung bei, wie Leerzeichen und Zeilenumbrueche, um die Lesbarkeit solcher Inhalte
            zu verbessern. Dieses Element kann in verschiedenen Teilen der JATS-Struktur auftreten,
            um spezifische Inhalte hervorzuheben oder zu separieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>preformat</h3>
          <p>The &lt;preformat&gt; element is used to display text that should be presented in a
            preformatted way, such as code or tables. It preserves formatting such as spaces and
            line breaks to enhance the readability of such content. This element can occur in
            various parts of the JATS structure to highlight or separate specific content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute ref="xml:space" use="required"/>
    </xsd:complexType>
  </xsd:element>


  <!-- XREF -->
  <xsd:element name="xref">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>xref</h3>
          <p>Das Element &lt;xref&gt; dient der Erstellung von Querverweisen innerhalb eines
            Dokuments. Es kann verwendet werden, um auf verschiedene Elemente wie Abbildungen,
            Tabellen, Formeln oder andere Abschnitte zu verweisen. Durch die Verwendung des
            @ref-type Attributs kann der Typ des referenzierten Inhalts angegeben werden, waehrend
            das @rid Attribut die spezifische ID des Zielobjekts referenziert. Dies ermoeglicht eine
            dynamische Verlinkung und Navigation innerhalb des JATS-Dokuments.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>xref</h3>
          <p>The &lt;xref&gt; element is used to create cross-references within a document. It can
            be used to refer to various elements such as figures, tables, formulas, or other
            sections. The @ref-type attribute allows specifying the type of the referenced content,
            while the @rid attribute references the specific ID of the target object. This enables
            dynamic linking and navigation within the JATS document.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="link-elements"/>
      </xsd:choice>
      <xsd:attribute name="custom-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="required" type="xsd:IDREFS"/>
      <xsd:attribute name="ref-type" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="aff"/>
            <xsd:enumeration value="app"/>
            <xsd:enumeration value="author-notes"/>
            <xsd:enumeration value="bibr"/>
            <xsd:enumeration value="boxed-text"/>
            <xsd:enumeration value="chem"/>
            <xsd:enumeration value="collab"/>
            <xsd:enumeration value="contrib"/>
            <xsd:enumeration value="corresp"/>
            <xsd:enumeration value="disp-formula"/>
            <xsd:enumeration value="fig"/>
            <xsd:enumeration value="fn"/>
            <xsd:enumeration value="kwd"/>
            <xsd:enumeration value="list"/>
            <xsd:enumeration value="plate"/>
            <xsd:enumeration value="scheme"/>
            <xsd:enumeration value="sec"/>
            <xsd:enumeration value="statement"/>
            <xsd:enumeration value="supplementary-material"/>
            <xsd:enumeration value="table"/>
            <xsd:enumeration value="table-fn"/>
            <xsd:enumeration value="other"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="label">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>label</h3>
          <p>Das Element &lt;label&gt; wird verwendet, um eine Bezeichnung oder Nummerierung fuer
            Elemente wie Gleichungen, Abbildungen, Referenzen usw. bereitzustellen. Es dient der
            klaren Identifizierung und Referenzierung innerhalb des JATS-Dokuments. &lt;label&gt;
            kann in verschiedenen Strukturen auftreten, um Elementen eine eindeutige Kennzeichnung
            zu geben, die im Text referenziert wird.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>label</h3>
          <p>The &lt;label&gt; element is used to provide a label or numbering for items such as
            equations, figures, references, etc. It serves to clearly identify and reference within
            the JATS document. &lt;label&gt; can occur in various structures to give elements a
            unique identification that is referenced in the text.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:element ref="inline-formula"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="alt" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <xsd:element name="title">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>title</h3>
          <p>Das Element &lt;title&gt; wird verwendet, um den Haupttitel von Dokumenten, Artikeln,
            Kapiteln oder Abschnitten innerhalb der JATS-Struktur anzugeben. Es ist ein zentrales
            Element, das in verschiedenen Kontexten wie &lt;article-meta&gt;, &lt;book-part-meta&gt;
            und &lt;title-group&gt; vorkommt, um den Titel des jeweiligen Inhalts klar zu
            definieren. &lt;title&gt; kann auch fuer Untertitel in Kombination mit &lt;subtitle&gt;
            verwendet werden, um zusaetzliche Informationen oder Erlaeuterungen zum Haupttitel zu
            liefern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>title</h3>
          <p>The &lt;title&gt; element is used to specify the main title of documents, articles,
            chapters, or sections within the JATS structure. It is a key element that appears in
            various contexts such as &lt;article-meta&gt;, &lt;book-part-meta&gt;, and
            &lt;title-group&gt; to clearly define the title of the respective content. &lt;title&gt;
            can also be used for subtitles in combination with &lt;subtitle&gt; to provide
            additional information or clarification to the main title.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="fn"/>
        <xsd:element ref="xref"/>
        <xsd:element ref="ext-link"/>
        <xsd:element ref="uri"/>
        <xsd:element ref="inline-formula"/>
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" type="xsd:string"/>
      <xsd:attribute name="id" type="xsd:ID"/>
      <xsd:attribute name="specific-use" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>

  <!-- PERSON GROUP -->
  <xsd:element name="person-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>person-group</h3>
          <p>Das Element &lt;person-group&gt; wird innerhalb der JATS-Struktur verwendet, um eine
            Gruppe von Personen zu definieren, die in verschiedenen Rollen auftreten koennen, wie
            Autoren, Herausgeber oder Gutachter. Es tritt haeufig in Elementen wie
            &lt;element-citation&gt;, &lt;contrib-group&gt; und &lt;aff&gt; auf, um die
            Zugehoerigkeit oder den Beitrag von Personen zu dokumentieren. &lt;person-group&gt; kann
            verschiedene Unterelemente wie &lt;name&gt;, &lt;surname&gt;, &lt;given-names&gt; und
            &lt;aff&gt; enthalten, um detaillierte Informationen ueber jede Person in der Gruppe
            bereitzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>person-group</h3>
          <p>The &lt;person-group&gt; element is used within the JATS structure to define a group of
            individuals who may serve in various roles such as authors, editors, or reviewers. It
            commonly appears in elements like &lt;element-citation&gt;, &lt;contrib-group&gt;, and
            &lt;aff&gt; to document the affiliation or contribution of individuals.
            &lt;person-group&gt; can include various sub-elements like &lt;name&gt;,
            &lt;surname&gt;, &lt;given-names&gt;, and &lt;aff&gt; to provide detailed information
            about each individual in the group.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="name"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="person-group-type" use="optional">
        <xsd:simpleType>

          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="allauthors"/>
            <xsd:enumeration value="assignee"/>
            <xsd:enumeration value="author"/>
            <xsd:enumeration value="compiler"/>
            <xsd:enumeration value="curator"/>
            <xsd:enumeration value="custom"/>
            <xsd:enumeration value="director"/>
            <xsd:enumeration value="editor"/>
            <xsd:enumeration value="guest-editor"/>
            <xsd:enumeration value="illustrator"/>
            <xsd:enumeration value="inventor"/>
            <xsd:enumeration value="research-assistant"/>
            <xsd:enumeration value="transed"/>
            <xsd:enumeration value="translator"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- NAMES -->
  <xsd:element name="name">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>name</h3>
          <p>Das Element &lt;name&gt; wird in der JATS-Struktur verwendet, um den Namen einer Person
            oder einer Entitaet zu spezifizieren. Es kann in verschiedenen Kontexten auftreten,
            beispielsweise innerhalb von &lt;contrib-group&gt; zur Angabe der Autoren eines Artikels
            oder in &lt;aff&gt; zur Nennung der Namen von Institutionen. Das &lt;name&gt;-Element
            kann Unterelemente wie &lt;surname&gt;, &lt;given-names&gt;, &lt;prefix&gt; und
            &lt;suffix&gt; enthalten, um den Namen detailliert zu beschreiben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>name</h3>
          <p>The &lt;name&gt; element is used within the JATS structure to specify the name of a
            person or an entity. It can occur in various contexts, for example, within
            &lt;contrib-group&gt; to list the authors of an article or in &lt;aff&gt; to mention the
            names of institutions. The &lt;name&gt; element may include sub-elements like
            &lt;surname&gt;, &lt;given-names&gt;, &lt;prefix&gt;, and &lt;suffix&gt; to detail the
            name comprehensively.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="surname"/>
            <xsd:element ref="given-names" minOccurs="0"/>
            <xsd:element ref="prefix" minOccurs="0"/>
          </xsd:sequence>
          <xsd:element ref="given-names"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="name-style" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="eastern"/>
            <xsd:enumeration value="given-only"/>
            <xsd:enumeration value="islensk"/>
            <xsd:enumeration value="western"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="surname">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>surname</h3>
          <p>Das Element &lt;surname&gt; wird innerhalb der JATS-Struktur verwendet, um den
            Nachnamen einer Person anzugeben. Es tritt typischerweise in Verbindung mit dem Element
            &lt;name&gt; auf, um in verschiedenen Kontexten, wie beispielsweise innerhalb einer
            &lt;person-group&gt; bei der Auflistung von Autoren eines Artikels, vollstaendige Namen
            zu spezifizieren. Der Nachname ist ein wesentlicher Bestandteil zur Identifikation und
            Zitierung von Personen in wissenschaftlichen Publikationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>surname</h3>
          <p>The &lt;surname&gt; element is used within the JATS structure to specify a person's
            last name. It typically appears in conjunction with the &lt;name&gt; element to provide
            complete names in various contexts, such as within a &lt;person-group&gt; when listing
            the authors of an article. The surname is a crucial component for identifying and citing
            individuals in scientific publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="given-names">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>given-names</h3>
          <p>Das Element &lt;given-names&gt; wird innerhalb der JATS-Struktur genutzt, um die
            Vornamen einer Person anzugeben. Es findet haeufig Anwendung in Kombination mit dem
            Element &lt;surname&gt;, um in verschiedenen Kontexten, wie beispielsweise innerhalb
            eines &lt;contrib-group&gt; Elements bei der Auflistung der Autoren eines
            wissenschaftlichen Artikels, vollstaendige Namen zu spezifizieren. Die Angabe der
            Vornamen ist entscheidend fuer die genaue Identifikation von Personen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>given-names</h3>
          <p>The &lt;given-names&gt; element is used within the JATS structure to specify a person's
            first names. It is commonly used in conjunction with the &lt;surname&gt; element to
            provide complete names in various contexts, such as within a &lt;contrib-group&gt;
            element when listing the authors of a scientific article. The inclusion of first names
            is crucial for the accurate identification of individuals.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  <xsd:element name="prefix">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Präfix</h3>
          <p>Ehrentitel oder andere Qualifikationen, die normalerweise vor dem Namen einer Person 
            stehen (z. B. Professor, Rev., Präsident, Senator, Dr., Sir).</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>prefix</h3>
          <p>Honorifics or other qualifiers that usually precede a person’s name (for example, 
            Professor, Rev., President, Senator, Dr., Sir).</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:sequence minOccurs="0" maxOccurs="unbounded">
        <xsd:choice/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  
  <!-- END NAMES -->






  <!-- SEC META -->
  <xsd:element name="sec-meta">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>sec-meta</h3>
          <p>Das Element &lt;sec-meta&gt; wird in der JATS-Struktur verwendet, um Metadaten
            spezifisch fuer einen Abschnitt innerhalb eines Dokuments zu definieren. Es ermoeglicht
            die Zuordnung von detaillierten Informationen wie Schluesselwoertern, Zusammenfassungen
            oder anderen spezifischen Daten, die fuer den jeweiligen Abschnitt relevant sind. Dieses
            Element traegt zur Verbesserung der Strukturierung und Auffindbarkeit von Informationen
            innerhalb wissenschaftlicher Publikationen bei.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>sec-meta</h3>
          <p>The &lt;sec-meta&gt; element is used within the JATS structure to define metadata
            specific to a section within a document. It allows for the assignment of detailed
            information such as keywords, abstracts, or other specific data relevant to the
            particular section. This element contributes to the enhancement of structuring and
            findability of information within scientific publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" ref="contrib-group"/>
        <xsd:element ref="kwd-group"/>
        <xsd:element ref="permissions" minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>




  <!-- LIST -->
  <xsd:element name="list">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>list</h3>
          <p>Das Element &lt;list&gt; wird in der JATS-Struktur verwendet, um Listen innerhalb eines
            wissenschaftlichen Artikels zu definieren. Es unterstuetzt verschiedene Listenarten, wie
            geordnete, ungeordnete und Definitionslisten, durch das Attribut @list-type. Listen
            dienen der strukturierten Darstellung von Informationen, wie Aufzaehlungen,
            Schritt-fuer-Schritt-Anleitungen oder thematisch zusammenhaengenden Punkten. Die
            Flexibilitaet bei der Gestaltung von Listen ermoeglicht eine klare und effektive
            Kommunikation komplexer Inhalte.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>list</h3>
          <p>The &lt;list&gt; element is used within the JATS structure to define lists within a
            scientific article. It supports various types of lists, such as ordered, unordered, and
            definition lists, through the @list-type attribute. Lists serve to structure information
            in a clear manner, including enumerations, step-by-step instructions, or thematically
            related points. The flexibility in designing lists enables clear and effective
            communication of complex content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element minOccurs="0" ref="title"/>
        <xsd:element minOccurs="0" maxOccurs="unbounded" ref="list-item"/>
      </xsd:sequence>
      <xsd:attribute name="continued-from" use="optional" type="xsd:IDREF"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="list-type" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NCName">
            <xsd:enumeration value="order"/>
            <xsd:enumeration value="bullet"/>
            <xsd:enumeration value="alpha-upper"/>
            <xsd:enumeration value="alpha-lower"/>
            <xsd:enumeration value="roman-upper"/>
            <xsd:enumeration value="roman-lower"/>
            <xsd:enumeration value="simple"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="prefix-word" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="list-item">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>list-item</h3>
          <p>Das Element &lt;list-item&gt; wird innerhalb der JATS-Struktur genutzt, um einzelne
            Eintraege innerhalb einer Liste (&lt;list&gt;) zu definieren. Jedes &lt;list-item&gt;
            repraesentiert einen Punkt oder ein Element in der Liste, das fuer die Strukturierung
            und Praesentation von Informationen in geordneter oder ungeordneter Form wichtig ist.
            Dies ermoeglicht eine klare Gliederung von Inhalten in wissenschaftlichen
            Publikationen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>list-item</h3>
          <p>The &lt;list-item&gt; element is used within the JATS structure to define individual
            entries within a list (&lt;list&gt;). Each &lt;list-item&gt; represents a point or an
            item in the list, which is crucial for structuring and presenting information in either
            an ordered or unordered manner. This allows for a clear organization of content in
            scientific publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="list"/>
        <xsd:element ref="def-list"/>
        <xsd:element ref="p"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END LIST -->

  <!-- DEF LIST -->
  <xsd:element name="def">
    <xsd:annotation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Definition</h3>
          <p>A specific explanation or clarification of a term used within a document, typically
            found in scientific, technical, or educational materials.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Definition</h3>
          <p>Eine spezifische Erklaerung oder Klarstellung eines Begriffs, der in einem Dokument
            verwendet wird, typischerweise in wissenschaftlichen, technischen oder
            Bildungsmaterialien gefunden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation>
        <div xmlns="http://www.w3.org/1999/xhtml">
          <h3>Definition List: Definition</h3>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="p" maxOccurs="unbounded"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="def-item">
    <xsd:annotation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Definition Item</h3>
          <p>A component of a definition list that pairs a term with its definition, used to
            structure detailed explanations in a systematic manner within documents.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Definitionselement</h3>
          <p>Ein Bestandteil einer Definitionsliste, der einen Begriff mit seiner Definition
            verbindet, verwendet, um detaillierte Erklaerungen in Dokumenten systematisch zu
            strukturieren.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="term"/>
        <xsd:element ref="def" minOccurs="0" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="def-list">
    <xsd:annotation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Definition List</h3>
          <p>A structured group of terms and their associated definitions, typically used in
            scientific and technical documents to clarify terminology.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Definitionsliste</h3>
          <p>Eine strukturierte Gruppe von Begriffen und deren zugehoerigen Definitionen, die
            typischerweise in wissenschaftlichen und technischen Dokumenten verwendet wird, um
            Terminologie zu klaeren.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0"/>
      	<xsd:choice minOccurs="0" maxOccurs="unbounded">
      		<xsd:element ref="term-head"/>
      	</xsd:choice>
      	<xsd:choice minOccurs="0" maxOccurs="unbounded">
      		<xsd:element ref="def-head"/>
      	</xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="def-item"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="def-list"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="continued-from" use="optional" type="xsd:IDREF"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="list-content" use="optional" type="xsd:string"/>
      <xsd:attribute name="list-type" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NCName">
            <xsd:enumeration value="order"/>
            <xsd:enumeration value="bullet"/>
            <xsd:enumeration value="alpha-upper"/>
            <xsd:enumeration value="alpha-lower"/>
            <xsd:enumeration value="roman-upper"/>
            <xsd:enumeration value="roman-lower"/>
            <xsd:enumeration value="simple"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="prefix-word" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
	
	
	<xsd:element name="def-head">
		<xsd:annotation>
			<xsd:documentation>
				<div xmlns="http://www.w3.org/1999/xhtml">
					<h3>Definition List: Definition Head</h3>
				</div>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:group ref="emphasis.class"/>
				<xsd:group ref="phrase-content.class"/>
				<xsd:group ref="subsup.class"/>
				<xsd:element ref="ext-link"/>
				<xsd:element ref="uri"/>					
				<xsd:element ref="alternatives"/>
				<xsd:element ref="inline-graphic"/>					
				<xsd:element ref="inline-formula"/>
				<xsd:element ref="mml:math"/>
				<xsd:element ref="fn"/>
				<xsd:element ref="xref"/>
			</xsd:choice>
			<xsd:attribute name="id" use="optional" type="xsd:ID"/>
			<xsd:attribute ref="xml:base" use="optional"/>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="term-head">
		<xsd:annotation>
			<xsd:documentation>
				<div xmlns="http://www.w3.org/1999/xhtml">
					<h3>Definition List: Term Head</h3>
				</div>
			</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType mixed="true">
			<xsd:choice minOccurs="0" maxOccurs="unbounded">
				<xsd:group ref="emphasis.class"/>
				<xsd:group ref="phrase-content.class"/>
				<xsd:group ref="subsup.class"/>
				<xsd:element ref="ext-link"/>
				<xsd:element ref="uri"/>					
				<xsd:element ref="alternatives"/>
				<xsd:element ref="inline-graphic"/>					
				<xsd:element ref="inline-formula"/>
				<xsd:element ref="mml:math"/>
				<xsd:element ref="fn"/>
				<xsd:element ref="xref"/>
			</xsd:choice>
			<xsd:attribute name="id" use="optional" type="xsd:ID"/>
			<xsd:attribute ref="xml:base" use="optional"/>
		</xsd:complexType>
	</xsd:element>
	
	
  <xsd:element name="term">
    <xsd:annotation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Term</h3>
          <p>A specific word or phrase used within the content that has a particular meaning, often
            defined as part of a definition list.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Begriff</h3>
          <p>Ein spezifisches Wort oder eine Phrase, die innerhalb des Inhalts verwendet wird und
            eine besondere Bedeutung hat, oft definiert als Teil einer Definitionsliste.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="inline-formula"/>
        <xsd:element ref="disp-formula"/>
        <xsd:element ref="disp-formula-group"/>
        <xsd:element ref="code"/>
        <xsd:element ref="inline-graphic"/>
        <xsd:element ref="preformat"/>
        <xsd:element ref="fn"/>
        <xsd:element ref="xref"/>
        <xsd:group ref="emphasis.class"/>
        <xsd:element ref="named-content"/>
        <xsd:element ref="styled-content"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END DEF-LIST -->


  <!-- INDEX TERM -->
  <!-- Not available in JATS 1.1 -->
  <!-- END INDEX TERM -->

  <!-- FIG / GRAPHIC / MEDIA -->
  <!-- FIG -->
  <xsd:element name="fig">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>fig</h3>
          <p>Das Element &lt;fig&gt; wird in der JATS-Struktur verwendet, um grafisches oder
            textuelles Material zu kennzeichnen, das als Abbildung identifiziert wird,
            ueblicherweise mit einer Beschriftung und einem Label wie "Abbildung 3." oder
            "Abbildung". Eine &lt;fig&gt; wird als Element definiert, das in einem
            Abbildungsverzeichnis erscheinen wuerde, wenn ein solches vorhanden waere. Der Inhalt
            einer &lt;fig&gt; muss nicht grafischer Natur sein; der Inhalt einer Abbildung kann eine
            Grafik, eine Liste, mehrere Absaetze, eine Gleichung, ein Zitat, eine Tabelle usw. oder
            eine Mischung aus mehreren dieser Elemente sein.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>fig</h3>
          <p>The &lt;fig&gt; element is used within the JATS structure to denote graphical or
            textual material that is identified as a figure, usually bearing a caption and a label
            such as "Figure 3." or "Figure". A &lt;fig&gt; is defined as an element that would
            appear in the Table of Figures, if there were one. The content of a &lt;fig&gt; need not
            be graphical in nature; the content of a figure may be a graphic, a list, several
            paragraphs, an equation, a display quote, a table, etc., or a mixture of several of
            these.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice minOccurs="0">
          <xsd:element ref="label"/>
        </xsd:choice>
        <xsd:choice minOccurs="0">
          <xsd:element ref="caption"/>
        </xsd:choice>
        <xsd:choice minOccurs="1" maxOccurs="unbounded">
          <xsd:element ref="alt-text"/>
        </xsd:choice>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="disp-formula-group"/>
          <xsd:element ref="disp-formula"/>
          <xsd:element ref="table-wrap"/>
          <xsd:element ref="p"/>
          <xsd:element ref="graphic"/>
          <xsd:element ref="media"/>
          <xsd:element ref="alternatives"/>
        </xsd:choice>
        <xsd:choice minOccurs="1" maxOccurs="unbounded">
          <xsd:element ref="permissions"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
        <!-- for DGUV: specific-use="image-size:{icon|s|m|l}" 
             with in satzspiegelbreite: 
             icon=5%; s=6% to 25%; m=26% to 50%; l=51% to 100% -->
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- GRAPHIC -->
  <xsd:element name="graphic">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>graphic</h3>
          <p>Das Element &lt;graphic&gt; wird in der JATS-Struktur verwendet, um auf eine externe
            Grafikdatei zu verweisen, die in das Dokument eingebettet oder mit diesem verknuepft
            ist. Es ermoeglicht die Einbindung von Bildmaterial wie Diagrammen, Fotos und
            Illustrationen in wissenschaftlichen Artikeln. Das Attribut @xlink:href wird genutzt, um
            den Pfad zur Grafikdatei anzugeben. &lt;graphic&gt; kann innerhalb verschiedener
            Elemente wie &lt;fig&gt;, &lt;body&gt; und &lt;supplementary-material&gt; vorkommen, um
            visuelle Inhalte entsprechend zu organisieren und zu praesentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>graphic</h3>
          <p>The &lt;graphic&gt; element is used within the JATS structure to reference an external
            graphic file that is embedded in or linked to the document. It facilitates the inclusion
            of visual materials such as diagrams, photographs, and illustrations in scientific
            articles. The @xlink:href attribute is used to specify the path to the graphic file.
            &lt;graphic&gt; can occur within various elements like &lt;fig&gt;, &lt;body&gt;, and
            &lt;supplementary-material&gt; to appropriately organize and present visual content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="alt-text"/>
        <xsd:element ref="permissions"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
        <!-- for DGUV: specific-use="image-size:{icon|s|m|l}" 
             with in satzspiegelbreite: 
             icon=5%; s=6% to 25%; m=26% to 50%; l=51% to 100% -->
      <xsd:attribute name="mimetype" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="required"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- INLINE GRAPHIC -->
  <xsd:element name="inline-graphic">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>inline-graphic</h3>
          <p>Das Element &lt;inline-graphic&gt; wird innerhalb der JATS-Struktur genutzt, um
            Grafiken direkt im Textfluss einzubinden. Es ermoeglicht die Integration von
            Bildmaterial, das nahtlos in den Text eingefuegt wird, wie z.B. kleine Symbole oder
            Formeln. Dieses Element unterstuetzt die visuelle Darstellung von Informationen, die
            direkt im Zusammenhang mit dem umgebenden Text stehen. &lt;inline-graphic&gt; kann in
            verschiedenen Kontexten wie innerhalb von Absaetzen (&lt;p&gt;), Anmerkungen
            (&lt;fn&gt;) oder sogar innerhalb von Ueberschriften (&lt;title&gt;) verwendet werden,
            um den Inhalt visuell zu bereichern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>inline-graphic</h3>
          <p>The &lt;inline-graphic&gt; element is used within the JATS structure to embed graphics
            directly into the flow of text. It facilitates the integration of visual material that
            is seamlessly inserted into the text, such as small icons or formulas. This element
            supports the visual representation of information that is directly related to the
            surrounding text. &lt;inline-graphic&gt; can be used in various contexts such as within
            paragraphs (&lt;p&gt;), footnotes (&lt;fn&gt;), or even within titles (&lt;title&gt;) to
            visually enhance the content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="alt-text" minOccurs="1"/>
        <xsd:element ref="permissions" minOccurs="1"/>
      </xsd:choice>      
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
        <xsd:attribute name="mimetype" use="optional" type="xsd:string"/>
        <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
        <!-- for DGUV: specific-use="image-size:{icon|s|m|l}" 
             with in satzspiegelbreite: 
             icon=5%; s=6% to 25%; m=26% to 50%; l=51% to 100% -->
      <xsd:attribute ref="xlink:href" use="required"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- MEDIA -->
  <xsd:element name="media">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>media</h3>
          <p>Das Element &lt;media&gt; wird in der JATS-Struktur verwendet, um auf ein nicht-XML,
            haeufig binaeres Objekt (wie einen Film, eine Audioaufnahme, einen Datensatz oder ein
            anderes nicht-XML-Format) zu verweisen, das integraler Bestandteil des Dokumenteninhalts
            ist. "Integral" bedeutet hierbei, dass das Medienobjekt innerhalb des Dokuments
            besprochen wird (und moeglicherweise darin angezeigt wird); das Medienobjekt ist Teil
            des Dokuments. &lt;media&gt; kann in verschiedenen Teilen des Dokuments verwendet
            werden, um multimediale Inhalte einzubinden, die fuer das Verstaendnis oder die
            Ergaenzung des Textes wesentlich sind.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>media</h3>
          <p>The &lt;media&gt; element is used within the JATS structure to point to a non-XML,
            often binary object (such as a movie, audio clip, dataset, or other non-XML format) that
            is an integral part of the document's content. "Integral" here means that the media
            object is discussed within (and possibly displayed within) the document; the media
            object is part of the document. &lt;media&gt; can be used in various parts of the
            document to incorporate multimedia content that is essential for understanding or
            supplementing the text.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="mimetype" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:href" use="required"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  
  <!-- ALTERNATIVES -->
  <xsd:element name="alternatives">
    <xsd:annotation>
      <xsd:documentation>
        <div xmlns="http://www.w3.org/1999/xhtml">
          <h3>Alternatives For Processing</h3>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>      
      <xsd:choice maxOccurs="unbounded">
        <xsd:element ref="graphic"/>
        <xsd:element ref="mml:math"/>
        <xsd:element ref="media"/>
        <xsd:element ref="table"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>  
  <!-- END FIG / GRAPHIC / MEDIA -->


  <!-- CAPTION -->
  <xsd:element name="caption">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>caption</h3>
          <p>Das Element &lt;caption&gt; dient als Container fuer die textuelle Beschreibung, die
            einem Objekt zugeordnet ist, wie zum Beispiel einer &lt;fig&gt; oder einem
            &lt;table-wrap&gt;. Eine Beschriftung ist eine sichtbare textuelle Beschreibung einer
            Tabelle, einer Figur oder eines aehnlichen Objekts. In Druck- oder Anzeigeformaten ist
            eine Beschriftung normalerweise erkennbar, da sie nicht Teil des gewoehnlichen
            Textflusses ist; sie befindet sich direkt unter, ueber, neben oder im gleichen kleinen
            Fenster oder Seitenbereich wie die tabellarischen Teile einer Tabelle oder die
            grafischen Teile einer Figur. Ein &lt;caption&gt; kann viele Arten von Text enthalten,
            die mit seinem Objekt verbunden sind, zum Beispiel einen Titel (als &lt;title&gt;
            gekennzeichnet), einen beschreibenden Absatz (&lt;p&gt;) oder eine Legende (die in
            dieser Suite nicht als separates Element identifiziert ist).</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>caption</h3>
          <p>The &lt;caption&gt; element serves as a container for the textual description
            associated with an object, such as a &lt;fig&gt; or a &lt;table-wrap&gt;. A caption is a
            visible textual description of a table, figure, or similar object. In print or display
            formats, a caption is usually recognizable because it is not part of the ordinary text
            flow; it sits just under, above, beside, or in the same small window or page area as the
            tabular portions of a table or the graphical portions of a figure. A &lt;caption&gt; may
            contain many kinds of text associated with its object, for example, a title (tagged as
            &lt;title&gt;), a descriptive paragraph (&lt;p&gt;), or a legend (which is not
            identified as a separate element in this Suite).</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:choice>
        <xsd:element ref="p"/>
        <xsd:element ref="title"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- ALT TEXT -->
  <xsd:element name="alt-text">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>alt-text</h3>
          <p>Das Element &lt;alt-text&gt; wird typischerweise von Screenreadern gelesen und kann
            auch verwendet werden, um einige Worte "hinter" einer Figur oder Grafik fuer Geraete mit
            begrenzter Grafikfaehigkeit anzuzeigen. Einige Screenreader kuerzen den &lt;alt-text&gt;
            auf 120 Zeichen, daher ist es eine bewaehrte Praxis, diesen kurz zu halten. Dieses Tag
            sollte fuer Zugaenglichkeitszwecke wie das Aussprechen durch Screenreader reserviert
            werden. Das Element sollte nicht als Ersatz fuer &lt;caption&gt; verwendet werden, das
            ein visuelles Element ist, das typischerweise neben einer Figur, Tabelle usw. angezeigt
            wird. Der &lt;alt-text&gt; ist kein visuelles Element, es sei denn, die Figur,
            Beschriftung oder ein anderes wichtiges Element, das den &lt;alt-text&gt; enthaelt, ist
            nicht verfuegbar oder kann von der Person oder dem Geraetetyp, der angesprochen wird,
            nicht verarbeitet werden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>alt-text</h3>
          <p>The &lt;alt-text&gt; element is typically read by screen readers, and &lt;alt-text&gt;
            may also be used to display a few words "behind" a figure or graphic for devices with
            limited graphics capacity. Some screen readers will truncate &lt;alt-text&gt; at 120
            characters, so it is best practice to keep this short. Please reserve this tag for
            accessibility uses such as pronouncing by screen readers. This element should not to be
            used as a replacement for &lt;caption&gt;, which is a visual element typically displayed
            alongside a figure, table, etc. The &lt;alt-text&gt; is not a visual element, unless the
            figure, caption, or other major element that holds the &lt;alt-text&gt; is not available
            or cannot be processed by the person or device-type being addressed.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
        <xsd:simpleContent>
          <xsd:extension base="xsd:string">
             <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
             <xsd:attribute name="id" use="optional" type="xsd:ID"/>
             <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
             <xsd:attribute ref="xml:base" use="optional"/>
             <xsd:attribute ref="xml:lang" use="optional"/>
          </xsd:extension>
        </xsd:simpleContent>
    </xsd:complexType>
  </xsd:element>

  <!-- Define the restricted string type -->
  <xsd:simpleType name="nonEmptyString">
    <xsd:restriction base="xsd:string">
      <xsd:minLength value="1"/>
      <xsd:whiteSpace value="collapse"/>
    </xsd:restriction>
  </xsd:simpleType>


  <!-- TABLE-WRAP-GROUP / TABLE-WRAP -->
  <xsd:element name="table-wrap-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>table-wrap-group</h3>
          <p>Das Element &lt;table-wrap-group&gt; dient zur Gruppierung mehrerer &lt;table-wrap&gt;
            Elemente, die zusammen eine logische Einheit innerhalb eines Dokuments bilden. Diese
            Struktur wird verwendet, um Tabellen und deren zugehoerige Informationen (wie
            Beschriftungen und Fussnoten) zusammenzuhalten, was die Organisation und das
            Referenzieren innerhalb des Dokuments erleichtert. Es ermoeglicht eine effizientere
            Verarbeitung und Darstellung von zusammengehoerigen Tabellen in der JATS-Struktur.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>table-wrap-group</h3>
          <p>The &lt;table-wrap-group&gt; element is used to group multiple &lt;table-wrap&gt;
            elements that together form a logical unit within a document. This structure is utilized
            to keep tables and their related information (such as captions and footnotes) together,
            facilitating organization and referencing within the document. It allows for more
            efficient processing and presentation of related tables in the JATS structure.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice minOccurs="0">
          <xsd:element ref="label"/>
        </xsd:choice>
        <xsd:choice minOccurs="0">
          <xsd:element ref="caption"/>
        </xsd:choice>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element ref="table-wrap"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="table-wrap">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>table-wrap</h3>
          <p>Das Element &lt;table-wrap&gt; wird verwendet, um eine Tabelle zusammen mit ihren
            Beschriftungen und Fussnoten als eine Einheit zu kapseln. Es ermoeglicht die Einbettung
            von Tabellen in den Textfluss und unterstuetzt die Zuordnung von ergaenzenden
            Informationen wie Titel und Beschreibungen. In der JATS-Struktur kann &lt;table-wrap&gt;
            innerhalb von Elementen wie &lt;fig-group&gt;, &lt;body&gt; und &lt;back&gt; vorkommen,
            um die Darstellung und Organisation von Tabellen in wissenschaftlichen Publikationen zu
            erleichtern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>table-wrap</h3>
          <p>The &lt;table-wrap&gt; element is used to encapsulate a table along with its captions
            and footnotes as a single unit. It facilitates the embedding of tables into the text
            flow and supports the association of supplementary information such as titles and
            descriptions. Within the JATS structure, &lt;table-wrap&gt; can occur within elements
            like &lt;fig-group&gt;, &lt;body&gt;, and &lt;back&gt; to aid in the presentation and
            organization of tables in scholarly publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="caption" minOccurs="0"/>
        <xsd:element ref="abstract" minOccurs="0"/>
        <xsd:element ref="table"/>
      </xsd:sequence>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>


  <!-- TABLE -->
  <xsd:element name="table">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>table</h3>
          <p>Das Element &lt;table&gt; repraesentiert eine Tabelle im JATS-Dokument. Es wird
            verwendet, um Daten in einer strukturierten Form darzustellen, typischerweise in Zeilen
            und Spalten. In der JATS-Struktur kann das &lt;table&gt;-Element innerhalb verschiedener
            uebergeordneter Elemente vorkommen, um Tabellen direkt im Textkoerper (&lt;body&gt;), in
            Anhaengen (&lt;back&gt;) oder innerhalb von Tabellenzusammenfassungen
            (&lt;table-wrap&gt;) zu platzieren. Es ermoeglicht eine klare und effiziente
            Praesentation von Forschungsergebnissen und statistischen Daten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>table</h3>
          <p>The &lt;table&gt; element represents a table in a JATS document. It is used to present
            data in a structured format, typically in rows and columns. Within the JATS structure,
            the &lt;table&gt; element can occur within various parent elements to place tables
            directly in the text body (&lt;body&gt;), appendices (&lt;back&gt;), or within table
            wraps (&lt;table-wrap&gt;) to facilitate a clear and efficient presentation of research
            findings and statistical data.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:choice>
          <xsd:element ref="colgroup" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:choice>
        <xsd:choice>
          <xsd:sequence>
            <xsd:element ref="thead" minOccurs="0"/>
            <xsd:element ref="tbody" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="border" use="optional" type="xsd:string"/>
      <xsd:attribute name="cellpadding" use="optional" type="xsd:string"/>
      <xsd:attribute name="cellspacing" use="optional" type="xsd:string"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="frame" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="above"/>
            <xsd:enumeration value="below"/>
            <xsd:enumeration value="border"/>
            <xsd:enumeration value="box"/>
            <xsd:enumeration value="hsides"/>
            <xsd:enumeration value="lhs"/>
            <xsd:enumeration value="rhs"/>
            <xsd:enumeration value="void"/>
            <xsd:enumeration value="vsides"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rules" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="all"/>
            <xsd:enumeration value="cols"/>
            <xsd:enumeration value="groups"/>
            <xsd:enumeration value="none"/>
            <xsd:enumeration value="rows"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="width" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  <!-- TABLE - COLGROUP -->
  <xsd:element name="colgroup">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>colgroup</h3>
          <p>Das Element &lt;colgroup&gt; dient als Containerelement zur Beschreibung von Gruppen
            von Spalten in einer Tabelle oder fuer alle Spalten in der Tabelle, falls nur eine
            &lt;colgroup&gt; vorhanden ist. Attribute auf &lt;colgroup&gt; gelten fuer alle Spalten
            in der Gruppe, es sei denn, sie werden auf &lt;col&gt; ueberschrieben. Dieses Element
            basiert auf dem XHTML colgroup-Element und soll leicht in dieses konvertierbar sein. In
            der JATS-Struktur kann &lt;colgroup&gt; innerhalb des &lt;table&gt;-Elements vorkommen,
            um die Darstellung und Organisation von Tabellenspalten in wissenschaftlichen
            Publikationen zu erleichtern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>colgroup</h3>
          <p>The &lt;colgroup&gt; element serves as a container element for describing groups of
            columns in a table or for all of the columns in the table if there is only one
            &lt;colgroup&gt;. Attributes on &lt;colgroup&gt; apply to all of the columns in the
            group unless overridden on &lt;col&gt;. This element is based on the XHTML colgroup
            element and is intended to be easily converted to it. Within the JATS structure,
            &lt;colgroup&gt; can occur within the &lt;table&gt; element to facilitate the
            presentation and organization of table columns in scholarly publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" ref="col"/>
      </xsd:sequence>
      <xsd:attribute name="span" use="optional" type="xsd:integer"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="col">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>col</h3>
          <p>Das Element &lt;col&gt; wird verwendet, um die Formatierungseigenschaften einer oder
            mehrerer Spalten in einer Tabelle zu definieren, ohne dass dafuer Inhalte direkt
            angegeben werden muessen. Es kann innerhalb des &lt;colgroup&gt;-Elements vorkommen, um
            spezifische Stile oder andere Attribute auf Spaltengruppen anzuwenden. In der
            JATS-Struktur kann &lt;col&gt; genutzt werden, um die Darstellung von Tabellenspalten in
            wissenschaftlichen Publikationen zu steuern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>col</h3>
          <p>The &lt;col&gt; element is used to define the formatting properties for one or more
            columns in a table without needing to provide content directly. It can occur within the
            &lt;colgroup&gt; element to apply specific styles or other attributes to groups of
            columns. Within the JATS structure, &lt;col&gt; can be used to control the presentation
            of table columns in scholarly publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="span" use="optional" type="xsd:integer"/>
      <xsd:attribute name="width" use="required"/>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
    </xsd:complexType>
  </xsd:element>

  <!-- THEAD -->
  <xsd:element name="thead">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>thead</h3>
          <p>Das Element &lt;thead&gt; wird verwendet, um den Kopfbereich einer Tabelle zu
            definieren, der die Spaltenueberschriften enthaelt. Dieses Element hilft dabei, die
            Struktur von Tabellen in Dokumenten zu organisieren, indem es eine klare Trennung
            zwischen dem Kopf der Tabelle und dem Koerper der Tabelle (&lt;tbody&gt;) ermoeglicht.
            In der JATS-Struktur kann &lt;thead&gt; innerhalb des &lt;table&gt;-Elements vorkommen,
            um die Lesbarkeit und Zugaenglichkeit von wissenschaftlichen Publikationen zu
            verbessern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>thead</h3>
          <p>The &lt;thead&gt; element is used to define the header section of a table, which
            contains the column headings. This element aids in organizing the structure of tables in
            documents by allowing a clear separation between the table's head and the body of the
            table (&lt;tbody&gt;). Within the JATS structure, &lt;thead&gt; can occur within the
            &lt;table&gt; element to enhance the readability and accessibility of scholarly
            publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" ref="tr"/>
      </xsd:sequence>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>

          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>

          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- TBODY -->
  <xsd:element name="tbody">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>tbody</h3>
          <p>Das Element &lt;tbody&gt; wird verwendet, um den Hauptteil einer Tabelle zu definieren,
            der die eigentlichen Datenzeilen enthaelt. Dieses Element ermoeglicht eine klare
            Trennung zwischen dem Kopf der Tabelle (&lt;thead&gt;), dem Koerper und dem Fuss der
            Tabelle (&lt;tfoot&gt;). In der JATS-Struktur kann &lt;tbody&gt; innerhalb des
            &lt;table&gt;-Elements vorkommen, um die Daten in wissenschaftlichen Publikationen
            strukturiert darzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>tbody</h3>
          <p>The &lt;tbody&gt; element is used to define the main body of a table, which contains
            the actual data rows. This element allows for a clear separation between the table's
            head (&lt;thead&gt;), the body, and the table's foot (&lt;tfoot&gt;). Within the JATS
            structure, &lt;tbody&gt; can occur within the &lt;table&gt; element to structure the
            data in scholarly publications.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element maxOccurs="unbounded" ref="tr"/>
      </xsd:sequence>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- TR -->
  <xsd:element name="tr">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>tr</h3>
          <p>Das Element &lt;tr&gt; steht fuer eine Tabellenzeile innerhalb einer Tabelle. Es wird
            verwendet, um die Zeilen einer Tabelle zu gruppieren, wobei jede Zeile durch ein
            &lt;tr&gt;-Element repraesentiert wird. Innerhalb des &lt;tr&gt;-Elements koennen
            &lt;td&gt; (Tabellenzelle) oder &lt;th&gt; (Kopfzelle) Elemente vorkommen, um die Zellen
            der jeweiligen Zeile zu definieren. In der JATS-Struktur kann &lt;tr&gt; innerhalb des
            &lt;table&gt;-Elements vorkommen, um die Daten in wissenschaftlichen Publikationen
            strukturiert und uebersichtlich darzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>tr</h3>
          <p>The &lt;tr&gt; element represents a table row within a table. It is used to group the
            rows of a table, with each row being represented by a &lt;tr&gt; element. Within the
            &lt;tr&gt; element, &lt;td&gt; (table cell) or &lt;th&gt; (header cell) elements can
            occur to define the cells of the respective row. In the JATS structure, &lt;tr&gt; can
            occur within the &lt;table&gt; element to structure the data in scholarly publications
            in an organized and clear manner.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:choice maxOccurs="unbounded">
        <xsd:element ref="th"/>
        <xsd:element ref="td"/>
      </xsd:choice>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- TH and TD -->
  <xsd:element name="th">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>th</h3>
          <p>Das Element &lt;th&gt; repraesentiert eine Kopfzelle in einer Tabelle, die dazu dient,
            die Daten in den darunter liegenden Zellen zu beschreiben oder zu kategorisieren. Es
            wird typischerweise in der ersten Zeile einer Tabelle innerhalb des
            &lt;thead&gt;-Elements verwendet, kann aber auch in anderen Teilen der Tabelle
            vorkommen, um Spalten oder Zeilen zu gruppieren. In der JATS-Struktur kann &lt;th&gt;
            innerhalb von &lt;table-wrap&gt;, &lt;tr&gt;, und &lt;td&gt; Elementen vorkommen, um
            wissenschaftliche Daten uebersichtlich und zugaenglich zu praesentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>th</h3>
          <p>The &lt;th&gt; element represents a header cell in a table, which is used to describe
            or categorize the data in the cells below it. It is typically used in the first row of a
            table within the &lt;thead&gt; element but can also appear in other parts of the table
            to group columns or rows. In the JATS structure, &lt;th&gt; can occur within
            &lt;table-wrap&gt;, &lt;tr&gt;, and &lt;td&gt; elements to present scientific data in an
            organized and accessible manner.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:group ref="inside-cell" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="headers" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rowspan" use="optional" type="xsd:integer"/>
      <xsd:attribute name="colspan" use="optional" type="xsd:integer"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="td">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>td</h3>
          <p>Das Element &lt;td&gt; steht fuer eine Zelle in einer Tabelle, die Daten enthaelt. Es
            wird innerhalb eines &lt;tr&gt;-Elements verwendet, um die einzelnen Datenpunkte in
            einer Zeile der Tabelle darzustellen. In der JATS-Struktur kann &lt;td&gt; innerhalb von
            &lt;table-wrap&gt;, &lt;tr&gt; und &lt;th&gt; Elementen vorkommen, um wissenschaftliche
            Daten in Tabellenform effektiv zu praesentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>td</h3>
          <p>The &lt;td&gt; element represents a cell in a table that contains data. It is used
            within a &lt;tr&gt; element to display individual data points in a row of the table. In
            the JATS structure, &lt;td&gt; can occur within &lt;table-wrap&gt;, &lt;tr&gt;, and
            &lt;th&gt; elements to effectively present scientific data in tabular form.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType mixed="true">
      <xsd:group ref="inside-cell" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rowspan" use="optional" type="xsd:integer"/>
      <xsd:attribute name="colspan" use="optional" type="xsd:integer"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="valign" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="baseline"/>
            <xsd:enumeration value="bottom"/>
            <xsd:enumeration value="middle"/>
            <xsd:enumeration value="top"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute name="align" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="center"/>
            <xsd:enumeration value="char"/>
            <xsd:enumeration value="justify"/>
            <xsd:enumeration value="left"/>
            <xsd:enumeration value="right"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
    </xsd:complexType>
  </xsd:element>

  <!-- INSIDE CELL -->
  <xsd:group name="inside-cell">
    <xsd:choice>
      <xsd:group ref="emphasis.class"/>
      <xsd:element ref="inline-formula"/>
      <xsd:element ref="disp-formula"/>
      <xsd:element ref="disp-formula-group"/>
      <xsd:element ref="list"/>
      <xsd:element ref="def-list"/>
      <xsd:element ref="p"/>
      <xsd:element ref="code"/>
      <xsd:group ref="phrase-content.class"/>
      <xsd:group ref="subsup.class"/>
    </xsd:choice>
  </xsd:group>
  <!-- END TABLE -->


  <!-- SUB / SUP  -->
  <xsd:element name="sub">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>sub</h3>
          <p>Das Element &lt;sub&gt; wird verwendet, um Text als tiefgestellt zu kennzeichnen. Dies
            ist besonders nuetzlich in wissenschaftlichen Dokumenten, um chemische Formeln,
            mathematische Indizes und andere spezialisierte Notationen darzustellen. In der
            JATS-Struktur kann &lt;sub&gt; innerhalb verschiedener Elemente wie &lt;p&gt;,
            &lt;td&gt;, und &lt;th&gt; vorkommen, um die Lesbarkeit und praezision der
            wissenschaftlichen Kommunikation zu verbessern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>sub</h3>
          <p>The &lt;sub&gt; element is used to mark text as subscript. This is particularly useful
            in scientific documents for representing chemical formulas, mathematical indices, and
            other specialized notations. In the JATS structure, &lt;sub&gt; can occur within various
            elements such as &lt;p&gt;, &lt;td&gt;, and &lt;th&gt; to enhance the readability and
            precision of scientific communication.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="sup">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>sup</h3>
          <p>Das Element &lt;sup&gt; wird verwendet, um Text als hochgestellt zu kennzeichnen. Dies
            findet Anwendung in wissenschaftlichen Dokumenten, um Exponenten, mathematische
            Potenzen, und Fussnotenverweise darzustellen. In der JATS-Struktur kann &lt;sup&gt;
            innerhalb verschiedener Elemente wie &lt;p&gt;, &lt;td&gt;, und &lt;th&gt; vorkommen, um
            die Genauigkeit und Lesbarkeit wissenschaftlicher Informationen zu erhaehen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>sup</h3>
          <p>The &lt;sup&gt; element is used to mark text as superscript. This is utilized in
            scientific documents to represent exponents, mathematical powers, and footnote
            references. In the JATS structure, &lt;sup&gt; can occur within various elements such as
            &lt;p&gt;, &lt;td&gt;, and &lt;th&gt; to enhance the accuracy and readability of
            scientific information.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>


  <!-- LINE BREAK -->
  <xsd:element name="break">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>break</h3>
          <p>Das Element &lt;break&gt; wird verwendet, um einen Zeilenumbruch innerhalb von Texten
            zu kennzeichnen. Es findet Anwendung in verschiedenen Strukturen der JATS-Dokumente, um
            die Lesbarkeit und Strukturierung von Inhalten wie Titeln, Abschnitten und Gedichten zu
            verbessern. Ein &lt;break&gt; Element ist besonders nuetzlich, um visuelle Trennungen
            ohne die Notwendigkeit eines neuen Absatzes zu erzeugen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>break</h3>
          <p>The &lt;break&gt; element is used to indicate a line break within texts. It is applied
            in various structures of JATS documents to enhance the readability and structuring of
            content such as titles, sections, and poems. A &lt;break&gt; element is particularly
            useful for creating visual separations without the need for a new paragraph.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <!-- CODE -->
  <xsd:element name="code">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>code</h3>
          <p>Das Element &lt;code&gt; wird verwendet, um vorformatierten Code innerhalb eines
            Dokuments zu kennzeichnen. Es kann in der JATS-Struktur auftreten, um Codebeispiele oder
            Codefragmente in wissenschaftlichen Artikeln, technischen Dokumentationen oder
            Lehrmaterialien darzustellen. Das &lt;code&gt; Element unterstuetzt Attribute wie
            code-type, language und language-version, um zusaetzliche Informationen ueber den
            dargestellten Code zu liefern.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>code</h3>
          <p>The &lt;code&gt; element is used to denote preformatted code within a document. It can
            occur in the JATS structure to present code examples or code snippets in scientific
            articles, technical documentation, or educational materials. The &lt;code&gt; element
            supports attributes such as code-type, language, and language-version to provide
            additional information about the code being displayed.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="language" use="optional" type="xsd:string"/>
      <xsd:attribute name="platforms" use="optional" type="xsd:string"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attributeGroup ref="orientationPosition"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
      <xsd:attribute ref="xml:space" fixed="preserve"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END CODE -->

  <!-- STYLED CONTENT / NAMED CONTENT - SIMILAR TO SPAN -->
  <xsd:element name="styled-content">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>styled-content</h3>
          <p>Das Element &lt;styled-content&gt; wird verwendet, um speziell formatierten Inhalt
            innerhalb der JATS-Struktur zu kennzeichnen. Es ermoeglicht die Angabe von
            Stilinformationen direkt im Inhalt, wie zum Beispiel fuer die typographische
            Unterscheidung von Textelementen. Das &lt;styled-content&gt; Element kann in
            verschiedenen Teilen eines Dokuments auftreten, um besondere Inhalte wie
            wissenschaftliche Namen, chemische Formeln oder andere fachspezifische Ausdruecke
            hervorzuheben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>styled-content</h3>
          <p>The &lt;styled-content&gt; element is used to denote specially formatted content within
            the JATS structure. It allows for the specification of style information directly within
            the content, such as for typographic differentiation of text elements. The
            &lt;styled-content&gt; element can occur in various parts of a document to highlight
            special content like scientific names, chemical formulas, or other subject-specific
            expressions.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="styled-content-elements"/>
      </xsd:choice>
      <xsd:attribute name="alt" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="style" use="optional" type="xsd:string"/>
      <xsd:attribute name="style-type" use="optional">
        <xsd:simpleType>
        	<xsd:union>
        		<xsd:simpleType>
        			<xsd:restriction base="xsd:NMTOKEN">
        				<xsd:enumeration value="_4octextinline_Medium"/>
        				<xsd:enumeration value="_4octextinline_MediumItalic"/>
        				<xsd:enumeration value="_WFarbeRot"/>
        				<xsd:enumeration value="_WFarbeBlau"/>
        				<xsd:enumeration value="_4Farbe1"/>
        				<xsd:enumeration value="_4Farbe2"/>
        				<xsd:enumeration value="_4Farbe3"/>
        				<xsd:enumeration value="_4octextinline_Farbe4"/>
        			</xsd:restriction>
        		</xsd:simpleType>
        		<xsd:simpleType>
        			<xsd:restriction base="xsd:string"/>
        		</xsd:simpleType>
        	</xsd:union>
        </xsd:simpleType>
      </xsd:attribute>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="named-content">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>named-content</h3>
          <p>Das Element &lt;named-content&gt; dient zur Kennzeichnung spezifischer Inhalte
            innerhalb der JATS-Struktur, die einen besonderen Namen oder eine besondere Bezeichnung
            tragen. Es kann beispielsweise verwendet werden, um chemische Verbindungen, Gensequenzen
            oder andere fachspezifische Begriffe zu markieren. Durch die Verwendung von
            &lt;named-content&gt; koennen diese Elemente eindeutig identifiziert und entsprechend
            formatiert oder verarbeitet werden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>named-content</h3>
          <p>The &lt;named-content&gt; element is used to mark specific content within the JATS
            structure that carries a special name or designation. For example, it can be used to tag
            chemical compounds, gene sequences, or other subject-specific terms. By using
            &lt;named-content&gt;, these elements can be uniquely identified and appropriately
            formatted or processed.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="named-content-elements"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="required" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="rid" use="optional" type="xsd:IDREFS"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xlink:actuate" use="optional"/>
      <xsd:attribute ref="xlink:href" use="optional"/>
      <xsd:attribute ref="xlink:role" use="optional"/>
      <xsd:attribute ref="xlink:show" use="optional"/>
      <xsd:attribute ref="xlink:title" use="optional"/>
      <xsd:attribute ref="xlink:type" use="optional" fixed="simple"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END STYLED CONTENT / NAMED CONTENT - SIMILAR TO SPAN -->


  <!-- BOLD / ITALIC / SC / STRIKE -->
  <xsd:element name="bold">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>bold</h3>
          <p>Das Element &lt;bold&gt; wird verwendet, um Text innerhalb der JATS-Struktur fett zu
            markieren. Dies dient der hervorgehobenen Darstellung von Textpassagen, die besondere
            Aufmerksamkeit erfordern oder aus anderen Gruenden betont werden sollen. &lt;bold&gt;
            kann in verschiedenen Kontexten auftreten, einschliesslich, aber nicht beschraenkt auf
            Absaetze (&lt;p&gt;), Beschriftungen (&lt;caption&gt;) und Zitatangaben
            (&lt;cite&gt;).</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>bold</h3>
          <p>The &lt;bold&gt; element is used to mark text within the JATS structure as bold. This
            serves to highlight text passages that require special attention or need to be
            emphasized for other reasons. &lt;bold&gt; can occur in various contexts, including, but
            not limited to, paragraphs (&lt;p&gt;), captions (&lt;caption&gt;), and citations
            (&lt;cite&gt;).</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="italic">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>italic</h3>
          <p>Das Element &lt;italic&gt; wird in der JATS-Struktur verwendet, um Text kursiv zu
            markieren. Dies dient dazu, Textteile hervorzuheben, die eine besondere Betonung
            benoetigen oder aus stilistischen Gruenden kursiv gesetzt werden sollen. Das
            &lt;italic&gt;-Element kann in verschiedenen Teilen des Dokuments auftreten, wie z.B. im
            Fliesstext, in ueberschriften oder in Zitatangaben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>italic</h3>
          <p>The &lt;italic&gt; element is used within the JATS structure to italicize text. This is
            used to highlight parts of the text that require special emphasis or are to be
            italicized for stylistic reasons. The &lt;italic&gt; element can appear in various parts
            of the document, such as in running text, headings, or citations.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
      <!-- toggle necessary as in JATS 1.1 Publishing DEFAULT is yes... -->
      <xsd:attribute name="toggle" use="optional">
        <xsd:simpleType>
          <xsd:restriction base="xsd:NMTOKEN">
            <xsd:enumeration value="no"/>
            <xsd:enumeration value="yes"/>
          </xsd:restriction>
        </xsd:simpleType>
      </xsd:attribute>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="underline">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>underline</h3>
          <p>Das Element &lt;underline&gt; wird verwendet, um Text in der JATS-Struktur zu
            unterstreichen. Dies kann genutzt werden, um die Wichtigkeit oder zur Hervorhebung
            spezifischer Textteile zu signalisieren. Das &lt;underline&gt;-Element kann in
            verschiedenen Kontexten innerhalb des Dokuments auftreten, einschliesslich Textkoerper,
            ueberschriften und Fussnoten.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>underline</h3>
          <p>The &lt;underline&gt; element is used to underline text within the JATS structure. This
            can be used to indicate importance or to highlight specific parts of the text. The
            &lt;underline&gt; element can occur in various contexts within the document, including
            body text, headings, and footnotes.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="strike">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>strike</h3>
          <p>Das Element &lt;strike&gt; wird in der JATS-Struktur verwendet, um Text
            durchzustreichen. Dies kann genutzt werden, um Textteile als geloescht oder
            ueberarbeitet zu kennzeichnen, ohne sie vollstaendig zu entfernen. Das
            &lt;strike&gt;-Element kann in verschiedenen Teilen des Dokuments auftreten, wie z.B. im
            Fliesstext, in Fussnoten oder in Zitatangaben.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>strike</h3>
          <p>The &lt;strike&gt; element is used within the JATS structure to strike through text.
            This can be used to mark parts of the text as deleted or revised without completely
            removing them. The &lt;strike&gt; element can appear in various parts of the document,
            such as in running text, footnotes, or citations.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="sc">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>sc</h3>
          <p>Das Element &lt;sc&gt; wird in der JATS-Struktur verwendet, um Text in Kapitaelchen
            darzustellen. Diese Textgestaltung wird oft genutzt, um visuelle Hervorhebungen oder
            stilistische Differenzierungen innerhalb des Textes zu erreichen, ohne die
            Schriftgroesse zu aendern. Das &lt;sc&gt;-Element kann in verschiedenen Kontexten des
            Dokuments auftreten, einschliesslich, aber nicht beschraenkt auf, Textkoerper,
            Ueberschriften und Zitate.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>sc</h3>
          <p>The &lt;sc&gt; element is used within the JATS structure to represent text in small
            capitals. This text styling is often used to achieve visual emphasis or stylistic
            differentiation within the text without changing the font size. The &lt;sc&gt; element
            can appear in various contexts of the document, including, but not limited to, body
            text, headings, and citations.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:group ref="emphasized-text"/>
      </xsd:choice>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
    </xsd:complexType>
  </xsd:element>


  <!-- END INLINE: BOLD / ITALIC / SC / STRIKE -->


  <!-- BLOCK FORMULA / INLINE FORMULA / MATHML -->
  <xsd:element name="disp-formula">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>disp-formula</h3>
          <p>Das Element &lt;disp-formula&gt; wird in der JATS-Struktur verwendet, um Formeln oder
            mathematische Ausdruecke anzuzeigen, die vom umgebenden Text abgesetzt sind. Dieses
            Element kann innerhalb verschiedener Strukturen wie Absaetzen, Sektionen oder Anhaengen
            vorkommen, um komplexe mathematische Inhalte klar und deutlich darzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>disp-formula</h3>
          <p>The &lt;disp-formula&gt; element is used within the JATS structure to display formulas
            or mathematical expressions that are set apart from the surrounding text. This element
            can appear within various structures such as paragraphs, sections, or appendices to
            clearly and effectively present complex mathematical content.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:choice minOccurs="0" maxOccurs="unbounded">
        <xsd:element ref="caption"/>
        <xsd:element ref="label"/>
        <xsd:element ref="inline-formula"/>
        <xsd:element ref="mml:math"/>
        <xsd:element ref="graphic"/>        
        <xsd:element ref="alternatives"/>
        <xsd:group ref="phrase-content.class"/>
        <xsd:group ref="emphasis.class"/>
        <xsd:group ref="subsup.class"/>
      </xsd:choice>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="disp-formula-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>disp-formula-group</h3>
          <p>Das Element &lt;disp-formula-group&gt; wird in der JATS-Struktur verwendet, um eine
            Gruppe von Gleichungen oder anderen mathematischen Ausdruecken darzustellen, die
            zusammen angezeigt werden sollen. Dieses Element sollte nicht fuer eine einzelne
            Gleichung oder einen einzelnen Ausdruck verwendet werden. Innerhalb dieser Gruppen
            koennen Gleichungen eine einzelne Gruppennummer erhalten, individuell nummeriert werden
            oder beides. Es kann in verschiedenen Teilen des Dokuments vorkommen, um komplexe
            mathematische Zusammenhaenge strukturiert darzustellen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>disp-formula-group</h3>
          <p>The &lt;disp-formula-group&gt; element is used within the JATS structure to represent a
            group of equations or other mathematical expressions that are intended to be displayed
            together. This element should not be used for a single equation or expression. Equations
            within such groups may be given a single group number, numbered individually, or both.
            It can appear in various parts of the document to present complex mathematical
            relationships in a structured manner.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="caption" minOccurs="0"/>
        <xsd:element ref="kwd-group" minOccurs="0" maxOccurs="unbounded"/>
        <xsd:choice minOccurs="0" maxOccurs="unbounded">
          <xsd:element ref="disp-formula"/>
        </xsd:choice>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>


  <xsd:element name="inline-formula">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>inline-formula</h3>
          <p>Das Element &lt;inline-formula&gt; wird in der JATS-Struktur verwendet, um
            mathematische Formeln oder Ausdruecke innerhalb eines Textflusses darzustellen. Im
            Gegensatz zu &lt;disp-formula&gt;, die fuer abgesetzte Formeln verwendet wird,
            ermoeglicht &lt;inline-formula&gt;, dass Formeln nahtlos in den laufenden Text
            integriert werden, ohne die Lesefluss zu unterbrechen. Dieses Element kann in Absaetzen,
            Ueberschriften oder anderen Textelementen vorkommen, um mathematische Inhalte direkt im
            Kontext zu praesentieren.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>inline-formula</h3>
          <p>The &lt;inline-formula&gt; element is used within the JATS structure to represent
            mathematical formulas or expressions within a flow of text. Unlike &lt;disp-formula&gt;,
            which is used for displayed formulas, &lt;inline-formula&gt; allows formulas to be
            seamlessly integrated into the running text without interrupting the reading flow. This
            element can appear in paragraphs, headings, or other text elements to present
            mathematical content directly in context.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType mixed="true">
      <xsd:group ref="inline-formula-elements" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  <!-- END BLOCK FORMULA / INLINE FORMULA / MATHML -->

  <!-- FOOTNOTE FN -->
  <xsd:element name="fn-group">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>Fußnoten-Gruppe</h3>
          <p>Containerelement für Fußnoten, die am Ende des Dokuments oder im Tabellenfuß erscheinen.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>Footnote Group</h3>
          <p>Container element for footnotes that appear at the end of the document on in table footer.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="title" minOccurs="0"/>
        <xsd:sequence maxOccurs="unbounded">
          <xsd:element ref="fn"/>
        </xsd:sequence>
      </xsd:sequence>
      <xsd:attribute name="content-type" use="optional" type="xsd:string"/>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>
  
  <xsd:element name="fn">
    <xsd:annotation>
      <xsd:documentation xml:lang="de">
        <div>
          <h3>fn</h3>
          <p>Das Element &lt;fn&gt; wird in der JATS-Struktur verwendet, um Fussnoten innerhalb
            eines Dokuments zu kennzeichnen. Fussnoten bieten zusaetzliche Informationen oder
            Verweise, die direkt im Textfluss erscheinen koennen, aber typischerweise am Ende der
            Seite oder des Dokuments gruppiert sind. Sie sind ein wichtiges Werkzeug fuer Autoren,
            um ergaenzende Inhalte bereitzustellen, ohne den Lesefluss zu stoeren. Das
            &lt;fn&gt;-Element kann in verschiedenen Teilen des Artikels vorkommen, einschliesslich,
            aber nicht beschraenkt auf den Haupttext, Tabellen und Abbildungslegenden.</p>
        </div>
      </xsd:documentation>
      <xsd:documentation xml:lang="en">
        <div>
          <h3>fn</h3>
          <p>The &lt;fn&gt; element is used within the JATS structure to denote footnotes within a
            document. Footnotes provide additional information or references that can appear
            directly in the flow of text but are typically grouped at the bottom of the page or
            document. They are a crucial tool for authors to provide supplementary content without
            disrupting the reading flow. The &lt;fn&gt; element can appear in various parts of the
            article, including but not limited to the main text, tables, and figure captions.</p>
        </div>
      </xsd:documentation>
    </xsd:annotation>

    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="label" minOccurs="0"/>
        <xsd:element ref="p" maxOccurs="unbounded"/>
      </xsd:sequence>
      <xsd:attribute name="id" use="optional" type="xsd:ID"/>
      <xsd:attribute name="specific-use" use="optional" type="xsd:string"/>
      <xsd:attribute name="symbol" use="optional" type="xsd:string"/>
      <xsd:attribute ref="xml:base" use="optional"/>
      <xsd:attribute ref="xml:lang" use="optional"/>
    </xsd:complexType>
  </xsd:element>



  <!-- ============= GROUPS ============= -->
  <xsd:group name="para-level">
    <xsd:choice>
      <xsd:group ref="block-display.class"/>
      <xsd:element ref="disp-formula"/>
      <xsd:element ref="disp-formula-group"/>
      <xsd:element ref="list"/>
      <xsd:element ref="def-list"/>
      <xsd:element ref="mml:math"/>
      <xsd:element ref="p"/>
      <xsd:element ref="disp-quote"/>
    </xsd:choice>
  </xsd:group>

  <!-- INLINE  -->
  <xsd:group name="emphasized-text">
    <xsd:choice>
      <xsd:element ref="fn"/>
      <xsd:element ref="xref"/>
      <xsd:element ref="inline-formula"/>
      <xsd:element ref="mml:math"/>
      <xsd:group ref="emphasis.class"/>
      <xsd:group ref="subsup.class"/>
      <xsd:group ref="phrase-content.class"/>
    	<xsd:element ref="ext-link"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="link-elements">
    <xsd:choice>
      <xsd:group ref="emphasis.class"/>
      <xsd:group ref="phrase-content.class"/>
      <xsd:group ref="subsup.class"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="inline-formula-elements">
    <xsd:choice>
      <xsd:element ref="inline-graphic"/>
      <xsd:group ref="phrase-content.class"/>
      <xsd:element ref="mml:math"/>
      <xsd:group ref="emphasis.class"/>
      <xsd:group ref="subsup.class"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="styled-content-elements">
    <xsd:choice>
      <xsd:element ref="disp-formula"/>
      <xsd:element ref="disp-formula-group"/>
      <xsd:element ref="inline-formula"/>
      <xsd:element ref="mml:math"/>
      <xsd:element ref="list"/>
      <xsd:element ref="def-list"/>
      <xsd:group ref="emphasis.class"/>
      <xsd:group ref="subsup.class"/>
      <xsd:group ref="phrase-content.class"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="named-content-elements">
    <xsd:choice>
      <xsd:element ref="fn"/>
      <xsd:element ref="xref"/>
      <xsd:element ref="fig"/>
      <xsd:element ref="fig-group"/>
      <xsd:element ref="disp-formula"/>
      <xsd:element ref="disp-formula-group"/>
      <xsd:element ref="list"/>
      <xsd:element ref="def-list"/>
      <xsd:element ref="inline-graphic"/>
      <xsd:element ref="inline-formula"/>
      <xsd:element ref="mml:math"/>
      <xsd:group ref="emphasis.class"/>
      <xsd:group ref="subsup.class"/>
      <xsd:group ref="phrase-content.class"/>
      <xsd:element ref="ext-link"/>
    </xsd:choice>
  </xsd:group>

  <!-- CLASSES -->
  <xsd:group name="emphasis.class">
    <xsd:choice>
      <xsd:element ref="bold"/>
      <xsd:element ref="italic"/>
      <xsd:element ref="sc"/>
      <xsd:element ref="strike"/>
      <xsd:element ref="underline"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="subsup.class">
    <xsd:choice>
      <xsd:element ref="sub"/>
      <xsd:element ref="sup"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="phrase-content.class">
    <xsd:choice>
      <xsd:element ref="named-content"/>
      <xsd:element ref="styled-content"/>
    </xsd:choice>
  </xsd:group>

  <xsd:group name="block-display.class">
    <xsd:choice>
      <xsd:element ref="boxed-text"/>
      <xsd:element ref="fig"/>
      <xsd:element ref="fig-group"/>
      <xsd:element ref="graphic"/>
      <xsd:element ref="media"/>
      <xsd:element ref="preformat"/>
      <xsd:element ref="table-wrap"/>
      <xsd:element ref="table-wrap-group"/>
    </xsd:choice>
  </xsd:group>

  <!-- references.class -->
  <xsd:group name="references.class">
    <!-- JATS - Very small subset here!! Needs to be extended -->
    <xsd:choice>
      <xsd:element ref="issue"/>
      <xsd:element ref="date"/>
      <xsd:element ref="publisher-loc"/>
      <xsd:element ref="publisher-name"/>
      <xsd:element ref="source"/>
      <xsd:element ref="ext-link"/>
      <xsd:element ref="uri"/>
