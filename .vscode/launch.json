{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/start-api",
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/applications/api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/applications/api/src",
        "API_RELOAD": "true"
      },
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
