{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/start-api",
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/applications/api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/applications/api/src",
        "API_RELOAD": "true"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest (all)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Pytest (selection)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["${file}", "-x", "-s"]
    }
  ]
}
