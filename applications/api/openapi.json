{
  "openapi": "3.1.0",
  "info": {
    "title": "JATS Import/Export API",
    "description": "An API for uploading JATS documents, importing them to different storage backends (e.g. Plone), and converting them to various formats.",
    "version": "1.0.0a5"
  },
  "paths": {
    "/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Health Status",
        "operationId": "get_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/upload/zip": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Upload a JATS Document (ZIP-file) to the storage",
        "description": "This endpoint accepts a ZIP file containing a JATS document (XML file) and optional referenced asset files and uploads it to the storage backend. The file can be provided either as a multipart form upload (`zip_file` field) or as a JSON body with the `zip_file` field set to a base64-encoded data URI (e.g. `data:application/zip;base64,<data>`). The target containers for the uploaded files and assets can be specified using the `container` and `assets_container` query parameters. If not specified, the default containers will be used.",
        "operationId": "upload_zip",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "container",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Container"
            }
          },
          {
            "name": "assets_container",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Assets Container"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadFileResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP400BadRequest"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP413PayloadTooLarge"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP415UnsupportedMediaType"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP500InternalServerError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "zip_file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "zip_file"
                ]
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "zip_file": {
                    "type": "string",
                    "description": "Base64-encoded data URI of the file (e.g. `data:<mime>;base64,<data>`)"
                  }
                },
                "required": [
                  "zip_file"
                ]
              }
            }
          }
        }
      }
    },
    "/upload/xml": {
      "post": {
        "tags": [
          "Upload"
        ],
        "summary": "Upload a JATS Document (XML) to the storage",
        "description": "This endpoint accepts a JATS document as an XML file upload and uploads it to the storage backend. Note that this endpoint does not support uploading referenced files, so it should only be used for simple JATS documents without external file references. The file can be provided either as a multipart form upload (`xml_file` field) or as a JSON body with the `xml_file` field set to a base64-encoded data URI (e.g. `data:application/xml;base64,<data>`). The target container for the uploaded file can be specified using the `container` query parameter. If not specified, the default container will be used.",
        "operationId": "upload_xml",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "container",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Container"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadFileResponse"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP400BadRequest"
                }
              }
            },
            "description": "Bad Request"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP413PayloadTooLarge"
                }
              }
            },
            "description": "Content Too Large"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP415UnsupportedMediaType"
                }
              }
            },
            "description": "Unsupported Media Type"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTP500InternalServerError"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "xml_file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "xml_file"
                ]
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xml_file": {
                    "type": "string",
                    "description": "Base64-encoded data URI of the file (e.g. `data:<mime>;base64,<data>`)"
                  }
                },
                "required": [
                  "xml_file"
                ]
              }
            }
          }
        }
      }
    },
    "/export/jats": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Export Jats",
        "operationId": "export_jats",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JatsDocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/export/html": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Export Html",
        "operationId": "export_html",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HtmlDocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/export/md": {
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Export Md",
        "operationId": "export_md",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkdownDocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/export/cache": {
      "delete": {
        "tags": [
          "Export"
        ],
        "summary": "Clear Export Cache",
        "operationId": "clear_export_cache",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheClearedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Export"
        ],
        "summary": "Get Cache Status",
        "operationId": "get_cache_status",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CacheClearedResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Confirmation message for cache clearance"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "CacheClearedResponse"
      },
      "CacheStatusResponse": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Indicates if FastAPICache is enabled"
          },
          "prefix": {
            "type": "string",
            "title": "Prefix",
            "description": "The cache prefix used by FastAPICache"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "prefix"
        ],
        "title": "CacheStatusResponse"
      },
      "HTTP400BadRequest": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "Bad request.",
            "examples": [
              "Bad request."
            ]
          }
        },
        "type": "object",
        "title": "HTTP400BadRequest"
      },
      "HTTP413PayloadTooLarge": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "The uploaded file is too large.",
            "examples": [
              "The uploaded file is too large."
            ]
          }
        },
        "type": "object",
        "title": "HTTP413PayloadTooLarge"
      },
      "HTTP415UnsupportedMediaType": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "Unsupported media type.",
            "examples": [
              "Unsupported media type."
            ]
          }
        },
        "type": "object",
        "title": "HTTP415UnsupportedMediaType"
      },
      "HTTP500InternalServerError": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": "An unexpected error occurred.",
            "examples": [
              "An unexpected error occurred."
            ]
          }
        },
        "type": "object",
        "title": "HTTP500InternalServerError"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HtmlDocumentResponse": {
        "properties": {
          "html": {
            "type": "string",
            "title": "Html",
            "description": "The HTML document"
          }
        },
        "type": "object",
        "required": [
          "html"
        ],
        "title": "HtmlDocumentResponse"
      },
      "JatsDocumentResponse": {
        "properties": {
          "jats": {
            "type": "string",
            "title": "Jats",
            "description": "The JATS XML document"
          }
        },
        "type": "object",
        "required": [
          "jats"
        ],
        "title": "JatsDocumentResponse"
      },
      "MarkdownDocumentResponse": {
        "properties": {
          "md": {
            "type": "string",
            "title": "Md",
            "description": "The Markdown document"
          }
        },
        "type": "object",
        "required": [
          "md"
        ],
        "title": "MarkdownDocumentResponse"
      },
      "UploadFileResponse": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "The URL of the uploaded file",
            "examples": [
              "http://example.com/files/uploaded_file"
            ]
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "UploadFileResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
